# ArtAlly — Environment Configuration (Node.js + Vercel + Supabase PostgreSQL)
APP_NAME="ArtAlly"
NODE_ENV=production
PORT=8000
SESSION_SECRET="artally-super-secret-session-key-2026"

# Supabase PostgreSQL Connection String (IPv4 Pooler + Direct URL)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
SUPABASE_DB_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Optional Supabase REST API Configuration
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Live Stripe Checkout Integration
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
