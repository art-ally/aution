<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<style>
.agr-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.35rem;
}
.agr-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
}
.agr-sig-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.35rem;
}
@media screen and (max-width: 680px) {
    .agr-grid-2, .agr-grid-3, .agr-sig-grid {
        grid-template-columns: 1fr;
    }
}

.pdf-no-break,
.contract-paper tr,
.contract-paper thead,
.contract-paper tfoot,
.sig-box,
.party-box,
.stage-card,
.commission-card,
.remittance-box {
    break-inside: avoid !important;
    page-break-inside: avoid !important;
}

.contract-paper h2,
.contract-paper h3 {
    break-after: avoid !important;
    page-break-after: avoid !important;
}

/* PDF Export Mode (used by Download Official PDF button for exact A4 layout) */
.pdf-export-mode {
    width: 794px !important;
    max-width: 794px !important;
    margin: 0 auto !important;
    padding: 20px 24px !important;
    box-shadow: none !important;
    background: #FBF9F5 !important;
    color: #161514 !important;
    box-sizing: border-box !important;
}
.pdf-export-mode .contract-paper-inner {
    padding: 18px 20px !important;
}
.pdf-export-mode .letterhead-banner {
    margin: -18px -20px 18px -20px !important;
    padding: 18px 20px !important;
}
.pdf-export-mode .agr-grid-2,
.pdf-export-mode .agr-sig-grid {
    grid-template-columns: 1fr 1fr !important;
    gap: 14px !important;
}
.pdf-export-mode .agr-grid-3 {
    grid-template-columns: 1fr 1fr 1fr !important;
    gap: 12px !important;
}
.pdf-export-mode .no-print {
    display: none !important;
}

@page {
    size: A4 portrait;
    margin: 10mm 10mm;
}

@media print {
    html, body, main, .section, .container {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        color: #161514 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
    header, footer, .announcement-bar, .flash-banner, .no-print {
        display: none !important;
    }
    .contract-paper {
        border: 2px solid #B8965A !important;
        box-shadow: none !important;
        margin: 0 !important;
        padding: 16px 18px !important;
        width: 100% !important;
        max-width: 100% !important;
        background: #FBF9F5 !important;
        box-decoration-break: clone;
        -webkit-box-decoration-break: clone;
    }
    .contract-paper-inner {
        border: 1px solid rgba(184, 150, 90, 0.55) !important;
        padding: 18px 20px !important;
        box-decoration-break: clone;
        -webkit-box-decoration-break: clone;
    }
    .letterhead-banner {
        margin: -18px -20px 18px -20px !important;
        padding: 18px 20px !important;
    }
    .agr-grid-2, .agr-sig-grid {
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 14px !important;
    }
    .agr-grid-3 {
        display: grid !important;
        grid-template-columns: 1fr 1fr 1fr !important;
        gap: 12px !important;
    }
    .pdf-no-break,
    .contract-paper tr,
    .contract-paper thead,
    .contract-paper tfoot,
    .sig-box,
    .party-box,
    .stage-card,
    .commission-card,
    .remittance-box {
        break-inside: avoid !important;
        page-break-inside: avoid !important;
    }
    table {
        page-break-inside: auto;
    }
    thead {
        display: table-header-group;
    }
    tfoot {
        display: table-footer-group;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
    }
}
</style>

<%
var $agr = $agreement || {};
var $currency = $agr['currency'] || 'USD';
var $lineItems = Array.isArray($agr['line_items']) ? $agr['line_items'] : [];
var $schedule = Array.isArray($agr['artworks_schedule']) ? $agr['artworks_schedule'] : [];
var $totalArtworks = Math.max(1, Number($agr['total_artworks'] ?? ($schedule.length || 1)));
var $perSubtotal = Number($agr['per_artwork_subtotal'] ?? 0);
var $vatRate = Number($agr['vat_rate'] ?? 15);
var $perVat = Number($agr['per_artwork_vat'] ?? 0);
var $perFee = Number($agr['per_artwork_fee'] ?? 0);
var $totSubtotal = Number($agr['total_auth_subtotal'] ?? ($perSubtotal * $totalArtworks));
var $totVat = Number($agr['total_auth_vat'] ?? ($perVat * $totalArtworks));
var $totFee = Number($agr['total_auth_fee'] ?? ($perFee * $totalArtworks));
var $commRate = Number($agr['commission_rate'] ?? 15);
var $artistShare = Number($agr['artist_share_rate'] ?? 85);
var $buyerPrem = Number($agr['buyer_premium_rate'] ?? 20);
var $isCountersigned = Boolean($agr['artist_signed']);
var $presetItems = Array.isArray($defaultAuthLineItems) ? $defaultAuthLineItems : [];
var $safePdfFilename = 'ArtAlly-Contract-' + String($agr['agreement_number'] || 'AGR-AA-2026').replace(/[^a-zA-Z0-9_-]/g, '-') + '.pdf';
%>

<section class="section" style="padding: 2.5rem 0 4rem;">
    <div class="container" style="max-width: 980px;">
        <!-- Top Action Bar (Hidden on Print & PDF) -->
        <div class="no-print" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; background: var(--bg-elevated); padding: 1rem 1.25rem; border: 1px solid var(--border-hairline);">
            <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <% if (hasRole('admin')) { %>
                    <a href="/admin/dashboard#agreement-generator" class="btn btn-outline btn-sm">&larr; Back to Admin Contract Generator</a>
                <% } else { %>
                    <a href="/artist/dashboard#contract-agreements" class="btn btn-outline btn-sm">&larr; Back to Artist Dashboard</a>
                <% } %>
                <% if (!empty($agr['invoice_id'])) { %>
                    <a href="/invoices/<%- Number($agr['invoice_id']) %>" class="btn btn-outline btn-sm" style="border-color: var(--accent-gold); color: var(--accent-gold);">
                        📄 View Aligned Invoice (<%- e($agr['invoice_number']) %>)
                    </a>
                <% } %>
            </div>
            <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
                <% if (hasRole('admin')) { %>
                    <button type="button" onclick="var el=document.getElementById('admin-agreement-breakdown-editor'); el.style.display = (el.style.display === 'none' ? 'block' : 'none');" class="btn btn-outline btn-sm" style="border-color: var(--accent-gold); color: var(--accent-gold);">
                        ✎ Edit Auth Descriptions &amp; Total Artworks
                    </button>
                <% } %>
                <button type="button" id="btn-download-contract-pdf" onclick="downloadOfficialContractPdf()" class="btn btn-gold btn-sm">
                    ⬇ Download Official PDF
                </button>
                <button type="button" onclick="window.print()" class="btn btn-outline btn-sm" style="border-color: #161514; color: #161514; font-weight: 700;">
                    🖨 Print / Save as PDF
                </button>
                <a href="/agreements/<%- Number($agr['id'] || 0) %>/download" class="btn btn-outline btn-sm">
                    ⬇ Download HTML Copy
                </a>
            </div>
        </div>

        <% if (hasRole('admin')) { %>
        <!-- Admin Live Breakdown & Artwork Count Editor (Syncs Agreement + Linked Invoice) -->
        <div id="admin-agreement-breakdown-editor" class="no-print" style="display: none; background: #181615; color: #F4EFE6; border: 2px solid #B8965A; padding: 1.75rem; margin-bottom: 1.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; border-bottom: 1px solid rgba(184, 150, 90, 0.35); padding-bottom: 1rem; margin-bottom: 1rem;">
                <div>
                    <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.18em; color: #C6A664; font-weight: 700; margin: 0 0 0.25rem;">
                        Admin Live Contract &amp; Invoice Alignment Editor
                    </p>
                    <h3 style="font-family: var(--font-serif); font-size: 1.35rem; color: #FBF9F5; margin: 0;">
                        Edit Authentication Descriptions &amp; Total Artworks for <%- e($agr['agreement_number']) %>
                    </h3>
                    <p style="font-size: 0.78rem; color: #A69F93; margin-top: 0.25rem;">
                        Saving changes here updates both this Contract Agreement and its aligned Authentication Invoice (<%- e($agr['invoice_number']) %>) so both documents remain 100% synchronized.
                    </p>
                </div>
                <button type="button" onclick="document.getElementById('admin-agreement-breakdown-editor').style.display='none'" style="background: transparent; border: 1px solid rgba(255,255,255,0.25); color: #D6D0C4; padding: 0.35rem 0.75rem; font-size: 0.75rem; cursor: pointer;">
                    Close ✕
                </button>
            </div>

            <div style="margin-bottom: 1rem;">
                <p style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.15em; color: #C6A664; font-weight: 700; margin-bottom: 0.5rem;">
                    + Quick-Add Preset Authentication Description or Custom Item:
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 0.45rem;">
                    <% for (const $pItem of $presetItems) { %>
                        <button type="button"
                            onclick='agrViewAddPresetItem(<%- JSON.stringify($pItem) %>)'
                            style="background: rgba(198,166,100,0.14); border: 1px solid #C6A664; color: #FBF9F5; padding: 0.35rem 0.65rem; font-size: 0.72rem; cursor: pointer;">
                            + <%- e($pItem.title) %> ($<%- Number($pItem.amount).toLocaleString('en-US', {minimumFractionDigits: 2}) %>)
                        </button>
                    <% } %>
                    <button type="button"
                        onclick="agrViewAddPresetItem({ key: 'custom', title: 'Custom Forensic / Authentication Verification Item', description: '- Specialized verification protocol.', amount: 500 })"
                        style="background: #C6A664; border: 1px solid #C6A664; color: #161514; font-weight: 700; padding: 0.35rem 0.75rem; font-size: 0.72rem; cursor: pointer;">
                        + Add Custom Description
                    </button>
                </div>
            </div>

            <form action="/admin/agreements/update-breakdown" method="POST">
                <%- csrf_field() %>
                <input type="hidden" name="agreement_id" value="<%- Number($agr['id']) %>">

                <div style="background: rgba(198,166,100,0.12); border: 1px solid #C6A664; padding: 1rem; margin-bottom: 1rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
                    <div>
                        <label style="display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.15em; color: #C6A664; font-weight: 700;">
                            Total Number of Artworks Covered by Agreement *
                        </label>
                        <p style="font-size: 0.75rem; color: #D6D0C4; margin: 0.2rem 0 0;">
                            Authentication payment is charged per each artwork. Total authentication payment = (Per-Artwork Fee incl. 15% VAT) &times; (Total Artworks).
                        </p>
                    </div>
                    <div>
                        <input type="number" id="agr-view-total-artworks" name="total_artworks" min="1" max="500" required value="<%- $totalArtworks %>" oninput="agrViewRecalc()" style="width: 130px; background: #0F0E0D; border: 2px solid #C6A664; color: #FFFFFF; padding: 0.5rem 0.75rem; font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; text-align: center;">
                    </div>
                </div>

                <div id="agr-view-items-container" style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.25rem;">
                    <% for (let $idx = 0; $idx < $lineItems.length; $idx++) {
                        const $item = $lineItems[$idx]; %>
                        <div class="agr-view-item-row" data-key="<%- e($item.key || '') %>" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(198,166,100,0.4); padding: 0.85rem;">
                            <input type="hidden" name="item_key[]" value="<%- e($item.key || 'item') %>">
                            <div style="display: grid; grid-template-columns: 1fr 170px auto; gap: 0.75rem; align-items: start;">
                                <div>
                                    <label style="display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.14em; color: #C6A664; margin-bottom: 0.25rem;">Description Heading *</label>
                                    <input type="text" name="item_title[]" required value="<%- e($item.title) %>" style="width: 100%; background: #0F0E0D; border: 1px solid rgba(255,255,255,0.22); color: #FFFFFF; padding: 0.45rem 0.6rem; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.45rem;">
                                    <label style="display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.14em; color: #A69F93; margin-bottom: 0.25rem;">Sub-Bullet Breakdown Details</label>
                                    <textarea name="item_description[]" rows="3" style="width: 100%; background: #0F0E0D; border: 1px solid rgba(255,255,255,0.18); color: #D6D0C4; padding: 0.45rem 0.6rem; font-family: var(--font-mono); font-size: 0.76rem;"><%- e($item.description) %></textarea>
                                </div>
                                <div>
                                    <label style="display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.14em; color: #C6A664; margin-bottom: 0.25rem;">Per-Artwork Amount (<%- e($currency) %>) *</label>
                                    <input type="number" step="0.01" min="0" name="item_amount[]" required value="<%- Number($item.amount || 0).toFixed(2) %>" oninput="agrViewRecalc()" style="width: 100%; background: #0F0E0D; border: 1px solid #C6A664; color: #C6A664; padding: 0.45rem 0.6rem; font-family: var(--font-mono); font-size: 0.95rem; font-weight: 700; text-align: right;">
                                </div>
                                <div style="padding-top: 1.25rem;">
                                    <button type="button" onclick="agrViewRemoveRow(this)" style="background: rgba(180, 40, 40, 0.25); border: 1px solid #D9534F; color: #FFB4B4; padding: 0.45rem 0.65rem; font-size: 0.72rem; cursor: pointer;">
                                        ✕ Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; background: #0F0E0D; border: 1px solid #C6A664; padding: 1rem 1.25rem;">
                    <div style="font-family: var(--font-mono); font-size: 0.82rem; color: #D6D0C4;">
                        Per-Artwork Fee (incl. 15% VAT): <strong id="agr-view-per-fee" style="color: #FFF;"><%- format_money_exact($perFee, $currency) %></strong>
                        &nbsp;&times;&nbsp; <strong id="agr-view-count-label" style="color: #C6A664;"><%- $totalArtworks %></strong> Artwork(s)
                        &nbsp;=&nbsp; Grand Total Auth Due: <strong id="agr-view-grand-total" style="color: #C6A664; font-size: 1rem;"><%- format_money_exact($totFee, $currency) %></strong>
                    </div>
                    <button type="submit" class="btn btn-gold btn-sm">
                        ✓ Save &amp; Sync Agreement + Invoice
                    </button>
                </div>
            </form>
        </div>
        <% } %>

        <!-- OFFICIAL ARTALLY LETTERHEADED CONTRACT AGREEMENT PAPER -->
        <div id="contract-printable-area" class="contract-paper" style="background: #FBF9F5; color: #161514; padding: 2.5rem 2.75rem; border: 2px solid #B8965A; box-shadow: 0 24px 60px rgba(0,0,0,0.55); position: relative;">
            <div class="contract-paper-inner" style="border: 1px solid rgba(184, 150, 90, 0.5); padding: 2.25rem;">

                <!-- HEADER + TITLE + PARTIES BLOCK (KEPT TOGETHER ON PAGE 1) -->
                <div class="pdf-no-break">
                    <!-- ARTALLY OFFICIAL INSTITUTIONAL LETTERHEAD BANNER -->
                    <div class="letterhead-banner" style="background: #161514; color: #FBF9F5; padding: 1.75rem 2rem; border-bottom: 3px solid #B8965A; margin: -2.25rem -2.25rem 1.85rem -2.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
                        <div style="display: flex; align-items: center; gap: 1.1rem;">
                            <!-- Institutional Crest Monogram -->
                            <div style="width: 58px; height: 58px; border: 2px solid #C6A664; background: #0F0E0D; display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: inset 0 0 0 2px rgba(198,166,100,0.25);">
                                <span style="font-family: var(--font-serif); font-size: 1.45rem; font-weight: 700; color: #C6A664; letter-spacing: 0.08em; line-height: 1;">AA</span>
                                <span style="font-size: 0.44rem; letter-spacing: 0.22em; color: #A69F93; text-transform: uppercase; margin-top: 2px;">GENEVA</span>
                            </div>
                            <div>
                                <p style="font-size: 0.62rem; letter-spacing: 0.24em; text-transform: uppercase; color: #C6A664; margin: 0 0 0.2rem; font-weight: 700;">
                                    ARTALLY · INTERNATIONAL FINE ART AUCTIONEERS &amp; CURATORIAL HOUSE
                                </p>
                                <h1 style="font-family: var(--font-serif); font-size: 1.95rem; color: #FBF9F5; font-weight: 600; letter-spacing: 0.14em; line-height: 1.05; margin: 0 0 0.25rem;">
                                    ARTALLY
                                </h1>
                                <p style="font-size: 0.74rem; color: #D6D0C4; margin: 0;">
                                    Rue du Rhône 42, 1204 Geneva, Switzerland · Salerooms: New York · London · Paris · <a href="mailto:Art-Ally@consultant.com" style="color: #C6A664; text-decoration: underline;">Art-Ally@consultant.com</a>
                                </p>
                            </div>
                        </div>

                        <div style="text-align: right;">
                            <div style="display: inline-block; padding: 0.28rem 0.75rem; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 0.4rem; border: 1px solid #C6A664; background: rgba(198, 166, 100, 0.18); color: #C6A664;">
                                <%- $isCountersigned ? '✓ FULLY EXECUTED & COUNTERSIGNED' : '✓ PRE-SIGNED & SEALED BY ARTALLY' %>
                            </div>
                            <p style="font-family: var(--font-mono); font-size: 0.84rem; font-weight: 700; color: #FFFFFF; margin: 0;">
                                Agreement Ref: <%- e($agr['agreement_number'] ?? 'AGR-AA-2026-0001') %>
                            </p>
                            <p style="font-family: var(--font-mono); font-size: 0.74rem; color: #C6A664; margin: 0.12rem 0 0;">
                                Aligned Invoice: <%- e($agr['invoice_number'] ?? 'INV-AUTH-ALIGNED') %>
                            </p>
                            <p style="font-size: 0.72rem; color: #A69F93; margin: 0.12rem 0 0;">
                                Date of Agreement: <%- e(substr($agr['platform_signed_at'] ?? $agr['created_at'] ?? gmdate('Y-m-d'), 0, 10)) %>
                            </p>
                        </div>
                    </div>

                    <!-- Document Title Banner -->
                    <div style="text-align: center; border-bottom: 2px solid #161514; padding-bottom: 1.15rem; margin-bottom: 1.5rem;">
                        <p style="font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: #8C6D32; font-weight: 700; margin: 0 0 0.3rem;">
                            CURATORIAL CONNOISSEURSHIP, AI FORENSIC AUTHENTICATION &amp; TIMED DIGITAL AUCTION DIVISION
                        </p>
                        <h2 style="font-family: var(--font-serif); font-size: 1.65rem; color: #161514; font-weight: 600; letter-spacing: 0.02em; margin: 0;">
                            ARTIST ARTWORK CONSIGNMENT, AUTHENTICATION &amp; DIGITAL AUCTION AGREEMENT
                        </h2>
                        <p style="font-size: 0.8rem; color: #57524C; margin: 0.35rem 0 0;">
                            This Artist Artwork Consignment, Authentication and Digital Auction Agreement (the <strong>&ldquo;Agreement&rdquo;</strong>) is entered into between the following Parties:
                        </p>
                    </div>

                    <!-- 1. THE DIGITAL AUCTION PLATFORM & 2. THE REGISTERED ARTIST -->
                    <div class="agr-grid-2" style="margin-bottom: 1.65rem;">
                        <!-- Party 1: ArtAlly -->
                        <div class="party-box" style="background: rgba(22, 21, 20, 0.03); border: 1px solid #DCD5C9; padding: 1.15rem 1.25rem;">
                            <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; color: #8C6D32; font-weight: 700; margin: 0 0 0.55rem; border-bottom: 1px solid #DCD5C9; padding-bottom: 0.4rem;">
                                1. THE DIGITAL AUCTION PLATFORM (&ldquo;ARTALLY&rdquo;)
                            </p>
                            <div style="font-size: 0.81rem; color: #2B2927; line-height: 1.6;">
                                <p style="margin: 0.18rem 0;"><strong>Platform / Company Name:</strong> ArtAlly</p>
                                <p style="margin: 0.18rem 0;"><strong>Registered Legal Name:</strong> ArtAlly International Fine Art Auctioneers &amp; Curatorial House Ltd.</p>
                                <p style="margin: 0.18rem 0;"><strong>Registered Address:</strong> Rue du Rhône 42, 1204 Geneva, Switzerland</p>
                                <p style="margin: 0.18rem 0;"><strong>Global Salerooms:</strong> Geneva · New York · London · Paris</p>
                                <p style="margin: 0.18rem 0;"><strong>Registration Number:</strong> CHE-418.920.315 (Geneva Commercial Registry)</p>
                                <p style="margin: 0.18rem 0;"><strong>Official Email:</strong> <a href="mailto:Art-Ally@consultant.com" style="color: #8C6D32; font-weight: 600;">Art-Ally@consultant.com</a></p>
                                <p style="margin: 0.4rem 0 0; font-size: 0.75rem; color: #57524C; font-style: italic;">Hereinafter referred to as <strong>&ldquo;ArtAlly&rdquo;</strong> or the <strong>&ldquo;Platform.&rdquo;</strong></p>
                            </div>
                        </div>

                        <!-- Party 2: Registered Artist (Auto-Populated from Registration) -->
                        <div class="party-box" style="background: rgba(184, 150, 90, 0.06); border: 1px solid #B8965A; padding: 1.15rem 1.25rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(184, 150, 90, 0.4); padding-bottom: 0.4rem; margin-bottom: 0.55rem; gap: 0.4rem;">
                                <p style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; color: #8C6D32; font-weight: 700; margin: 0;">
                                    2. THE REGISTERED ARTIST / ARTWORK OWNER
                                </p>
                                <span style="font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.1em; background: #161514; color: #C6A664; padding: 0.14rem 0.45rem; font-weight: 700; white-space: nowrap;">
                                    Auto-Filled from Registration
                                </span>
                            </div>
                            <div style="font-size: 0.81rem; color: #2B2927; line-height: 1.6;">
                                <p style="margin: 0.18rem 0;"><strong>Full Legal Name:</strong> <span style="font-weight: 700; color: #161514;"><%- e($agr['artist_full_name']) %></span></p>
                                <p style="margin: 0.18rem 0;"><strong>Professional / Studio Name:</strong> <%- e($agr['artist_professional_name']) %></p>
                                <p style="margin: 0.18rem 0;"><strong>Registered Address / Studio:</strong> <%- e($agr['artist_address']) %></p>
