<script>
function agrViewFormatMoney(val) {
    var num = Number(val || 0);
    return '$' + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function agrViewRecalc() {
    var container = document.getElementById('agr-view-items-container');
    if (!container) return;
    var inputs = container.querySelectorAll('input[name="item_amount[]"]');
    var subtotal = 0;
    inputs.forEach(function (inp) {
        var v = parseFloat(inp.value);
        if (!isNaN(v) && v > 0) subtotal += v;
    });
    var vat = Math.round(subtotal * 0.15 * 100) / 100;
    var perFee = Math.round((subtotal + vat) * 100) / 100;
    var countEl = document.getElementById('agr-view-total-artworks');
    var count = countEl ? Math.max(1, parseInt(countEl.value || '1', 10)) : 1;
    var grandTotal = Math.round(perFee * count * 100) / 100;

    var perEl = document.getElementById('agr-view-per-fee');
    var lblEl = document.getElementById('agr-view-count-label');
    var totEl = document.getElementById('agr-view-grand-total');
    if (perEl) perEl.textContent = agrViewFormatMoney(perFee);
    if (lblEl) lblEl.textContent = String(count);
    if (totEl) totEl.textContent = agrViewFormatMoney(grandTotal);
}

function agrViewRemoveRow(btn) {
    var container = document.getElementById('agr-view-items-container');
    if (!container) return;
    var rows = container.querySelectorAll('.agr-view-item-row');
    if (rows.length <= 1) {
        alert('At least 1 authentication description must remain.');
        return;
    }
    var row = btn.closest('.agr-view-item-row');
    if (row) row.remove();
    agrViewRecalc();
}

function agrViewAddPresetItem(item) {
    var container = document.getElementById('agr-view-items-container');
    if (!container) return;
    var div = document.createElement('div');
    div.className = 'agr-view-item-row';
    div.setAttribute('data-key', item.key || 'custom');
    div.style.cssText = 'background: rgba(255,255,255,0.04); border: 1px solid rgba(198,166,100,0.4); padding: 0.85rem;';
    div.innerHTML =
        '<input type="hidden" name="item_key[]" value="' + (item.key || 'custom').replace(/"/g, '&quot;') + '">' +
        '<div style="display: grid; grid-template-columns: 1fr 170px auto; gap: 0.75rem; align-items: start;">' +
            '<div>' +
                '<label style="display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.14em; color: #C6A664; margin-bottom: 0.25rem;">Description Heading *</label>' +
                '<input type="text" name="item_title[]" required value="' + String(item.title || '').replace(/"/g, '&quot;') + '" style="width: 100%; background: #0F0E0D; border: 1px solid rgba(255,255,255,0.22); color: #FFFFFF; padding: 0.45rem 0.6rem; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.45rem;">' +
                '<label style="display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.14em; color: #A69F93; margin-bottom: 0.25rem;">Sub-Bullet Breakdown Details</label>' +
                '<textarea name="item_description[]" rows="3" style="width: 100%; background: #0F0E0D; border: 1px solid rgba(255,255,255,0.18); color: #D6D0C4; padding: 0.45rem 0.6rem; font-family: var(--font-mono); font-size: 0.76rem;"></textarea>' +
            '</div>' +
            '<div>' +
                '<label style="display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.14em; color: #C6A664; margin-bottom: 0.25rem;">Per-Artwork Amount *</label>' +
                '<input type="number" step="0.01" min="0" name="item_amount[]" required value="' + Number(item.amount || 0).toFixed(2) + '" oninput="agrViewRecalc()" style="width: 100%; background: #0F0E0D; border: 1px solid #C6A664; color: #C6A664; padding: 0.45rem 0.6rem; font-family: var(--font-mono); font-size: 0.95rem; font-weight: 700; text-align: right;">' +
            '</div>' +
            '<div style="padding-top: 1.25rem;">' +
                '<button type="button" onclick="agrViewRemoveRow(this)" style="background: rgba(180, 40, 40, 0.25); border: 1px solid #D9534F; color: #FFB4B4; padding: 0.45rem 0.65rem; font-size: 0.72rem; cursor: pointer;">✕ Remove</button>' +
            '</div>' +
        '</div>';
    var ta = div.querySelector('textarea[name="item_description[]"]');
    if (ta) ta.value = item.description || '';
    container.appendChild(div);
    agrViewRecalc();
}

function downloadOfficialContractPdf() {
    var el = document.getElementById('contract-printable-area');
    if (!el) {
        window.print();
        return;
    }
    if (typeof html2pdf === 'undefined') {
        window.print();
        return;
    }

    var btn = document.getElementById('btn-download-contract-pdf');
    var origText = btn ? btn.innerHTML : '';
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '⏳ Generating Clean Multi-Page PDF...';
    }

    el.classList.add('pdf-export-mode');

    // Smart Page-Break Spacer Engine: ensure no .pdf-no-break block, table, or signature crosses an A4 page boundary
    var adjustedElements = [];
    try {
        var pageWidthPx = 794;
        // Printable A4 height corresponding to 794px width with 8mm top/bottom margin
        var pageHeightPx = Math.floor(pageWidthPx * (281 / 194));
        var blocks = el.querySelectorAll('.pdf-no-break');
        for (var i = 0; i < blocks.length; i++) {
            var blk = blocks[i];
            // Skip nested .pdf-no-break if an ancestor .pdf-no-break already wraps it
            var parentNoBreak = blk.parentElement ? blk.parentElement.closest('.pdf-no-break') : null;
            if (parentNoBreak && el.contains(parentNoBreak)) continue;

            var rootRect = el.getBoundingClientRect();
            var blkRect = blk.getBoundingClientRect();
            var relTop = blkRect.top - rootRect.top;
            var height = blkRect.height;
            var relBottom = relTop + height;

            var startPage = Math.floor(relTop / pageHeightPx);
            var endPage = Math.floor((relBottom - 4) / pageHeightPx);

            if (startPage !== endPage && height < pageHeightPx * 0.92) {
                var pushDown = (startPage + 1) * pageHeightPx - relTop + 14;
                var prevMargin = blk.style.marginTop || '';
                var computedMargin = parseFloat(window.getComputedStyle(blk).marginTop || '0') || 0;
                blk.style.marginTop = (computedMargin + pushDown) + 'px';
                adjustedElements.push({ el: blk, prevMargin: prevMargin });
            }
        }
    } catch (e) {
        console.warn('PDF page-break pre-calculation notice:', e);
    }

    var opt = {
        margin: [8, 8, 8, 8],
        filename: '<%- e($safePdfFilename) %>',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: {
            scale: 2,
            useCORS: true,
            letterRendering: true,
            backgroundColor: '#FBF9F5',
            windowWidth: 820
        },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
        pagebreak: { mode: ['css', 'legacy'], avoid: ['.pdf-no-break', 'tr', 'tfoot', '.sig-box'] }
    };

    html2pdf().set(opt).from(el).save().then(function () {
        adjustedElements.forEach(function (item) {
            item.el.style.marginTop = item.prevMargin;
        });
        el.classList.remove('pdf-export-mode');
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = origText;
        }
    }).catch(function () {
        adjustedElements.forEach(function (item) {
            item.el.style.marginTop = item.prevMargin;
        });
        el.classList.remove('pdf-export-mode');
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = origText;
        }
        window.print();
    });
}

document.addEventListener('DOMContentLoaded', function () {
    var params = new URLSearchParams(window.location.search);
    if (params.get('edit') === '1') {
        var ed = document.getElementById('admin-agreement-breakdown-editor');
        if (ed) ed.style.display = 'block';
    }
    if (params.get('download_pdf') === '1') {
        setTimeout(function () {
            downloadOfficialContractPdf();
        }, 450);
    } else if (params.get('print') === '1') {
        setTimeout(function () {
            window.print();
        }, 350);
    }
});
</script>
