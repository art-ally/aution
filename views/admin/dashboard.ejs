                                <% var $agrCur = $agrRow?.['currency'] ?? 'USD';
                                   var $agrWorksCount = Math.max(1, Number($agrRow?.['total_artworks'] ?? 1)); %>
                                <tr class="hover:bg-ivory/60">
                                    <td class="py-3.5 px-4 font-mono font-semibold text-obsidian">
                                        <%- e($agrRow?.['agreement_number']) %>
                                        <div class="text-[10px] text-stone font-sans">Issued: <%- e(substr($agrRow?.['created_at'] ?? '', 0, 10)) %></div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="font-semibold text-obsidian"><%- e($agrRow?.['artist_full_name']) %></div>
                                        <div class="text-[11px] text-stone"><%- e($agrRow?.['artist_email']) %> · <%- e($agrRow?.['artist_country']) %></div>
                                        <div class="text-[10px] font-mono text-bronze"><%- e($agrRow?.['artist_registration_ref']) %></div>
                                    </td>
                                    <td class="py-3.5 px-4 font-mono">
                                        <% if (!empty($agrRow?.['invoice_id'])) { %>
                                            <a href="/invoices/<%- Number($agrRow?.['invoice_id']) %>" class="text-bronze underline font-semibold"><%- e($agrRow?.['invoice_number']) %></a>
                                        <% } else { %>
                                            <span class="text-stone"><%- e($agrRow?.['invoice_number'] || 'Aligned') %></span>
                                        <% } %>
                                        <div class="text-[10px] text-stone font-sans"><%- (Array.isArray($agrRow?.['line_items']) ? $agrRow['line_items'].length : 5) %> synced description(s)</div>
                                    </td>
                                    <td class="py-3.5 px-4 font-mono text-obsidian">
                                        <div class="font-bold text-sm text-bronze">
                                            Total (<%- $agrWorksCount %> work<%- $agrWorksCount === 1 ? '' : 's' %>): <%- format_money_exact(Number($agrRow?.['total_auth_fee'] ?? 0), $agrCur) %>
                                        </div>
                                        <div class="text-[10px] text-stone">
                                            <%- format_money_exact(Number($agrRow?.['per_artwork_fee'] ?? 0), $agrCur) %> per artwork (incl. 15% VAT)
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4 text-[11px]">
                                        <span class="font-semibold text-obsidian">15% ArtAlly</span> / <strong class="text-[#1B4332]">85% Artist</strong>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="bg-[#1A2E22] text-ivory text-[10px] uppercase tracking-widest px-2 py-0.5 font-semibold block w-max mb-1">
                                            ✓ ArtAlly Signed
                                        </span>
                                        <% if ($agrRow?.['artist_signed']) { %>
                                            <span class="bg-bronze text-white text-[10px] uppercase tracking-widest px-2 py-0.5 font-semibold block w-max">
                                                ✓ Artist Signed
                                            </span>
                                        <% } else { %>
                                            <span class="bg-stone/20 text-charcoal text-[10px] uppercase tracking-widest px-2 py-0.5 block w-max">
                                                Artist Line Ready
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5 px-4 text-right space-x-1.5 whitespace-nowrap">
                                        <a href="/agreements/<%- Number($agrRow?.['id']) %>?edit=1" class="inline-block px-3 py-1.5 border border-bronze bg-bronze/10 text-bronze text-[10px] uppercase tracking-widest font-semibold hover:bg-bronze hover:text-white transition">
                                            ✎ Edit Auth &amp; Count
                                        </a>
