<%
var $admUnpaid = Object.values($authInvoices || []).filter(function (i) { return i && (i.status || 'unpaid') !== 'paid'; }).length;
var $admAwaitSign = Object.values($contractAgreements || []).filter(function (a) { return a && !a.artist_signed; }).length;
