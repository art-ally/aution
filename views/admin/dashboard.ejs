                                            <input type="hidden" name="agreement_id" value="<%- Number($agrRow?.['id']) %>">
                                            <button type="submit" class="px-2.5 py-1.5 border border-red-800 text-red-800 text-[10px] uppercase tracking-widest hover:bg-red-800 hover:text-white transition">
