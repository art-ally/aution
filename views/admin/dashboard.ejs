                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
</div></details>
    </section>
</div>

    <script>
    function toggleInvoicePaymentMethod(mode) {
        var bankBlock = document.getElementById('inv_bank_block');
        var cryptoBlock = document.getElementById('inv_crypto_block');
        if (!bankBlock || !cryptoBlock) return;
        bankBlock.style.display = (mode === 'crypto') ? 'none' : 'block';
        cryptoBlock.style.display = (mode === 'bank') ? 'none' : 'block';
    }
    function autoFillInvoiceArtist(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (!opt || opt.value === '0') return;
        var nameEl = document.getElementById('inv_artist_name');
        var emailEl = document.getElementById('inv_artist_email');
        var detailsEl = document.getElementById('inv_artist_details');
        if (nameEl && opt.getAttribute('data-name')) nameEl.value = opt.getAttribute('data-name');
        if (emailEl && opt.getAttribute('data-email')) emailEl.value = opt.getAttribute('data-email');
        if (detailsEl && opt.getAttribute('data-details')) detailsEl.value = opt.getAttribute('data-details');
    }
    function autoFillInvoiceArtwork(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (!opt || opt.value === '0') return;
        var titleEl = document.getElementById('inv_artwork_title');
        var refEl = document.getElementById('inv_reference_code');
        var detailsEl = document.getElementById('inv_artwork_details');
        var nameEl = document.getElementById('inv_artist_name');
        var emailEl = document.getElementById('inv_artist_email');
        var artistSelect = document.getElementById('quick_select_artist');
        if (titleEl && opt.getAttribute('data-title')) titleEl.value = opt.getAttribute('data-title');
        if (refEl && opt.getAttribute('data-ref')) refEl.value = opt.getAttribute('data-ref');
        if (detailsEl && opt.getAttribute('data-details')) detailsEl.value = opt.getAttribute('data-details');
        if (nameEl && !nameEl.value && opt.getAttribute('data-artist-name')) nameEl.value = opt.getAttribute('data-artist-name');
        if (emailEl && !emailEl.value && opt.getAttribute('data-artist-email')) emailEl.value = opt.getAttribute('data-artist-email');
        if (artistSelect && opt.getAttribute('data-artist-id')) {
            artistSelect.value = opt.getAttribute('data-artist-id');
        }
    }

    var DEFAULT_GEN_ITEMS = <%- JSON.stringify($presetList) %>;

    function getCurrencySymbol() {
        var sel = document.getElementById('inv_currency_select');
        var cur = sel ? sel.value : 'USD';
        if (cur === 'EUR') return '€';
        if (cur === 'GBP') return '£';
        if (cur === 'CHF') return 'CHF ';
        return '$';
    }

    function formatGenMoney(val) {
        var sym = getCurrencySymbol();
        var num = Number(val || 0);
        return sym + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function recalcGeneratorBreakdown() {
        var container = document.getElementById('generator_line_items_container');
        if (!container) return;
        var amountInputs = container.querySelectorAll('input[name="item_amount[]"]');
        var subtotal = 0;
        var count = amountInputs.length;
        amountInputs.forEach(function (inp) {
            var v = parseFloat(inp.value);
            if (!isNaN(v) && v > 0) subtotal += v;
        });
        subtotal = Math.round(subtotal * 100) / 100;
        var vat = Math.round(subtotal * 0.15 * 100) / 100;
        var total = Math.round((subtotal + vat) * 100) / 100;

        var countEl1 = document.getElementById('gen_item_count');
        var countEl2 = document.getElementById('gen_footer_count');
        var subEl1 = document.getElementById('gen_subtotal_display');
        var subEl2 = document.getElementById('gen_footer_subtotal');
        var vatEl1 = document.getElementById('gen_vat_display');
        var vatEl2 = document.getElementById('gen_footer_vat');
        var totEl1 = document.getElementById('gen_total_display');
        var totEl2 = document.getElementById('gen_footer_total');
        var hiddenFee = document.getElementById('inv_fee_amount_hidden');

        if (countEl1) countEl1.textContent = String(count);
        if (countEl2) countEl2.textContent = String(count);
        if (subEl1) subEl1.textContent = formatGenMoney(subtotal);
        if (subEl2) subEl2.textContent = formatGenMoney(subtotal);
        if (vatEl1) vatEl1.textContent = formatGenMoney(vat);
        if (vatEl2) vatEl2.textContent = formatGenMoney(vat);
        if (totEl1) totEl1.textContent = formatGenMoney(total);
        if (totEl2) totEl2.textContent = formatGenMoney(total);
        if (hiddenFee) hiddenFee.value = total.toFixed(2);
    }

    function removeGeneratorLineItem(btn) {
        var container = document.getElementById('generator_line_items_container');
        if (!container) return;
        var rows = container.querySelectorAll('.generator-item-row');
        if (rows.length <= 1) {
            alert('At least 1 description must remain in the invoice description list.');
            return;
        }
        var row = btn.closest('.generator-item-row');
        if (row) row.remove();
        recalcGeneratorBreakdown();
    }

    function addGeneratorLineItem(item) {
        var container = document.getElementById('generator_line_items_container');
        if (!container) return;
        var div = document.createElement('div');
        div.className = 'generator-item-row bg-white/5 border border-white/15 p-4 grid grid-cols-1 sm:grid-cols-12 gap-4 items-start';
        div.setAttribute('data-key', item.key || 'custom');
        div.innerHTML =
            '<input type="hidden" name="item_key[]" value="' + String(item.key || 'custom').replace(/"/g, '&quot;') + '">' +
            '<div class="sm:col-span-8 space-y-2">' +
                '<label class="block text-[9px] uppercase tracking-widest text-bronzeLight font-semibold">Description Title *</label>' +
                '<input type="text" name="item_title[]" required value="' + String(item.title || '').replace(/"/g, '&quot;') + '" class="w-full bg-[#0F0E0D] border border-white/25 px-3 py-2 text-sm font-mono font-bold text-white">' +
                '<label class="block text-[9px] uppercase tracking-widest text-stone font-semibold">Breakdown Bullet Points (Shown under Title on Invoice)</label>' +
                '<textarea name="item_description[]" rows="3" class="w-full bg-[#0F0E0D] border border-white/15 px-3 py-2 text-xs font-mono text-stone leading-relaxed"></textarea>' +
            '</div>' +
            '<div class="sm:col-span-3">' +
                '<label class="block text-[9px] uppercase tracking-widest text-bronzeLight font-semibold sm:text-right mb-1">Amount *</label>' +
                '<input type="number" step="0.01" min="0" name="item_amount[]" required value="' + Number(item.amount || 0).toFixed(2) + '" oninput="recalcGeneratorBreakdown()" class="w-full bg-[#0F0E0D] border-2 border-bronze px-3 py-2.5 text-base font-mono font-bold text-bronzeLight text-right">' +
            '</div>' +
            '<div class="sm:col-span-1 flex sm:justify-end pt-5">' +
                '<button type="button" onclick="removeGeneratorLineItem(this)" class="px-2.5 py-2 bg-red-950/60 border border-red-600/70 text-red-200 text-[10px] uppercase tracking-widest font-semibold hover:bg-red-700 hover:text-white transition" title="Remove this description from invoice">✕ Remove</button>' +
            '</div>';
        var ta = div.querySelector('textarea[name="item_description[]"]');
        if (ta) ta.value = item.description || '';
        container.appendChild(div);
        recalcGeneratorBreakdown();
    }

    function resetAllDefaultGeneratorItems() {
        var container = document.getElementById('generator_line_items_container');
        if (!container) return;
        container.innerHTML = '';
        DEFAULT_GEN_ITEMS.forEach(function (item) {
            addGeneratorLineItem(item);
        });
    }

    function getAgrCurrencySymbol() {
        var sel = document.getElementById('agr_currency_select');
        var cur = sel ? sel.value : 'USD';
        if (cur === 'EUR') return '€';
        if (cur === 'GBP') return '£';
        if (cur === 'CHF') return 'CHF ';
        return '$';
    }

    function formatAgrMoney(val) {
        var sym = getAgrCurrencySymbol();
        var num = Number(val || 0);
        return sym + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function recalcAgreementGenerator() {
        var container = document.getElementById('agr_generator_items_container');
        if (!container) return;
        var amountInputs = container.querySelectorAll('input[name="item_amount[]"]');
        var subtotal = 0;
        var count = amountInputs.length;
        amountInputs.forEach(function (inp) {
            var v = parseFloat(inp.value);
            if (!isNaN(v) && v > 0) subtotal += v;
        });
        subtotal = Math.round(subtotal * 100) / 100;
        var vat = Math.round(subtotal * 0.15 * 100) / 100;
        var perFee = Math.round((subtotal + vat) * 100) / 100;
        var worksInput = document.getElementById('agr_total_artworks');
        var totalArtworks = worksInput ? Math.max(1, parseInt(worksInput.value || '1', 10)) : 1;
        var grandTotal = Math.round(perFee * totalArtworks * 100) / 100;

        var cEl = document.getElementById('agr_gen_item_count');
        var subEl = document.getElementById('agr_gen_per_sub');
        var vatEl = document.getElementById('agr_gen_per_vat');
        var feeEl = document.getElementById('agr_gen_per_fee');
        var artCountEl = document.getElementById('agr_gen_art_count');
        var artPluralEl = document.getElementById('agr_gen_art_plural');
        var grandEl = document.getElementById('agr_gen_grand_total');

        if (cEl) cEl.textContent = String(count);
        if (subEl) subEl.textContent = formatAgrMoney(subtotal);
        if (vatEl) vatEl.textContent = formatAgrMoney(vat);
        if (feeEl) feeEl.textContent = formatAgrMoney(perFee);
        if (artCountEl) artCountEl.textContent = String(totalArtworks);
        if (artPluralEl) artPluralEl.textContent = totalArtworks === 1 ? '' : 's';
        if (grandEl) grandEl.textContent = formatAgrMoney(grandTotal);
    }

    function addAgreementGeneratorItem(item) {
        var container = document.getElementById('agr_generator_items_container');
        if (!container) return;
        var div = document.createElement('div');
        div.className = 'agr-gen-item-row bg-white/5 border border-white/15 p-4 grid grid-cols-1 sm:grid-cols-12 gap-4 items-start';
        div.setAttribute('data-key', item.key || 'custom');
        div.innerHTML =
            '<input type="hidden" name="item_key[]" value="' + String(item.key || 'custom').replace(/"/g, '&quot;') + '">' +
            '<div class="sm:col-span-8 space-y-2">' +
                '<label class="block text-[9px] uppercase tracking-widest text-bronzeLight font-semibold">Authentication Description Title *</label>' +
                '<input type="text" name="item_title[]" required value="' + String(item.title || '').replace(/"/g, '&quot;') + '" class="w-full bg-[#0F0E0D] border border-white/25 px-3 py-2 text-sm font-mono font-bold text-white">' +
                '<label class="block text-[9px] uppercase tracking-widest text-stone font-semibold">Forensic Protocol Sub-Bullets</label>' +
                '<textarea name="item_description[]" rows="2" class="w-full bg-[#0F0E0D] border border-white/15 px-3 py-2 text-xs font-mono text-stone leading-relaxed"></textarea>' +
            '</div>' +
            '<div class="sm:col-span-3">' +
                '<label class="block text-[9px] uppercase tracking-widest text-bronzeLight font-semibold sm:text-right mb-1">Per-Artwork Fee *</label>' +
                '<input type="number" step="0.01" min="0" name="item_amount[]" required value="' + Number(item.amount || 0).toFixed(2) + '" oninput="recalcAgreementGenerator()" class="w-full bg-[#0F0E0D] border-2 border-bronze px-3 py-2.5 text-base font-mono font-bold text-bronzeLight text-right">' +
            '</div>' +
            '<div class="sm:col-span-1 flex sm:justify-end pt-5">' +
                '<button type="button" onclick="removeAgreementGeneratorItem(this)" class="px-2.5 py-2 bg-red-950/60 border border-red-600/70 text-red-200 text-[10px] uppercase tracking-widest font-semibold hover:bg-red-700 hover:text-white transition">✕ Remove</button>' +
            '</div>';
        var ta = div.querySelector('textarea[name="item_description[]"]');
        if (ta) ta.value = item.description || '';
        container.appendChild(div);
        recalcAgreementGenerator();
    }

    function removeAgreementGeneratorItem(btn) {
        var container = document.getElementById('agr_generator_items_container');
        if (!container) return;
        var rows = container.querySelectorAll('.agr-gen-item-row');
        if (rows.length <= 1) {
            alert('At least 1 authentication description must remain on the agreement.');
            return;
        }
        var row = btn.closest('.agr-gen-item-row');
        if (row) row.remove();
        recalcAgreementGenerator();
    }

    function resetDefaultAgreementItems() {
        var container = document.getElementById('agr_generator_items_container');
        if (!container) return;
        container.innerHTML = '';
        DEFAULT_GEN_ITEMS.forEach(function (item) {
            addAgreementGeneratorItem(item);
        });
    }

    function autoFillAgreementFromArtist(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (!opt || opt.value === '0') return;
        var fullEl = document.getElementById('agr_artist_full_name');
        var profEl = document.getElementById('agr_artist_prof_name');
        var emailEl = document.getElementById('agr_artist_email');
        var countryEl = document.getElementById('agr_artist_country');
        var addrEl = document.getElementById('agr_artist_address');
        var discEl = document.getElementById('agr_artist_discipline');
        var regEl = document.getElementById('agr_artist_reg_ref');
        var worksEl = document.getElementById('agr_total_artworks');
        var invSel = document.getElementById('agr_select_invoice');

        if (fullEl && opt.getAttribute('data-full-name')) fullEl.value = opt.getAttribute('data-full-name');
        if (profEl && opt.getAttribute('data-prof-name')) profEl.value = opt.getAttribute('data-prof-name');
        if (emailEl) emailEl.value = opt.getAttribute('data-email') || '';
        if (countryEl && opt.getAttribute('data-country')) countryEl.value = opt.getAttribute('data-country');
        if (addrEl && opt.getAttribute('data-address')) addrEl.value = opt.getAttribute('data-address');
        if (discEl && opt.getAttribute('data-discipline')) discEl.value = opt.getAttribute('data-discipline');
        if (regEl && opt.getAttribute('data-reg-ref')) regEl.value = opt.getAttribute('data-reg-ref');
        if (worksEl && opt.getAttribute('data-artworks-count')) {
            worksEl.value = opt.getAttribute('data-artworks-count');
        }

        var latestInvId = opt.getAttribute('data-latest-invoice-id');
        if (invSel && latestInvId && Number(latestInvId) > 0) {
            invSel.value = latestInvId;
            autoFillAgreementFromInvoice(invSel);
        } else {
            recalcAgreementGenerator();
        }
    }

    function autoFillAgreementFromInvoice(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (!opt || opt.value === '0') return;
        var cur = opt.getAttribute('data-currency');
        var srv = opt.getAttribute('data-service');
        var itemsJson = opt.getAttribute('data-items');
        var curSel = document.getElementById('agr_currency_select');
        var srvInput = document.getElementById('agr_service_type');
        if (curSel && cur) curSel.value = cur;
        if (srvInput && srv) srvInput.value = srv;

        if (itemsJson) {
            try {
                var parsed = JSON.parse(itemsJson);
                if (Array.isArray(parsed) && parsed.length > 0) {
                    var container = document.getElementById('agr_generator_items_container');
                    if (container) {
                        container.innerHTML = '';
                        parsed.forEach(function (item) {
                            addAgreementGeneratorItem(item);
                        });
                    }
                }
            } catch (e) {}
        }
        recalcAgreementGenerator();
    }

    document.addEventListener('DOMContentLoaded', function () {
        recalcAgreementGenerator();
    });
    </script>

<div class="adm-panel" data-panel="artists" data-title="Registered Artists" data-crumb="Artists &amp; Artworks">
    <!-- SECTION 1: Real Registered Artists, Public Profile Approval Gate & All Uploaded Artworks -->
    <section id="artists" class="bg-white border border-hairline p-8 space-y-8">
        <div class="border-b border-hairline pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <p class="text-[10px] uppercase tracking-widest text-bronze font-semibold">Real Artist Registrations &amp; Profile Approval Gate</p>
