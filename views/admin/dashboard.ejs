                            <% if (empty($artistWorks)) { %>
                                <p class="text-xs text-stone bg-white p-4 border border-hairline">This artist has not uploaded any artworks yet.</p>
                            <% } else { %>
                                <div class="space-y-4">
                                    <% for (const $work of Object.values($artistWorks || [])) { %>
                                        <% var $sub = $work?.['submission'] ?? [];
                                        var $auc = $work?.['auction'] ?? null;
                                        var $workImages = $work?.['images'] ?? [];
                                        var $aucState = $auc?.['status'] ?? 'unscheduled';
                                        var $expectedPrice = Number(($sub?.['artist_expected_price'] ?? $work?.['artist_expected_price'] ?? $work?.['estimate_high'] ?? $work?.['reserve_price'] ?? 0));
                                        var $agreedPrice = Number(($work?.['agreed_price'] ?? $sub?.['agreed_price'] ?? $auc?.['agreed_price'] ?? $work?.['reserve_price'] ?? $expectedPrice));
                                        var $startingBid = Number(($auc?.['starting_bid'] ?? $work?.['starting_bid'] ?? 1000));
                                        var $currentBid = Number(($auc?.['current_bid'] ?? $startingBid));
                                        var $reservePrice = Number(($auc?.['reserve_price'] ?? $work?.['reserve_price'] ?? $agreedPrice));
                                        var $priceAgreementStatus = $work?.['price_agreement_status'] ?? $sub?.['price_agreement_status'] ?? 'pending';
                                        var $negotiationMessages = $sub?.['negotiation_messages'] ?? []; %>
                                        <div class="bg-white border border-hairline p-5 grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
                                            <!-- Uploaded Images & Artwork Details -->
                                            <div class="xl:col-span-4 space-y-3">
