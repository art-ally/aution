                            <div class="sm:col-span-8 space-y-2">
                                <label class="block text-[9px] uppercase tracking-widest text-bronzeLight font-semibold">Description Title *</label>
                                <input type="text" name="item_title[]" required value="<%- e($item.title) %>" class="w-full bg-[#0F0E0D] border border-white/25 px-3 py-2 text-sm font-mono font-bold text-white">
                                <label class="block text-[9px] uppercase tracking-widest text-stone font-semibold">Breakdown Bullet Points (Shown under Title on Invoice)</label>
                                <textarea name="item_description[]" rows="3" class="w-full bg-[#0F0E0D] border border-white/15 px-3 py-2 text-xs font-mono text-stone leading-relaxed"><%- e($item.description) %></textarea>
                            </div>
                            <div class="sm:col-span-3">
                                <label class="block text-[9px] uppercase tracking-widest text-bronzeLight font-semibold sm:text-right mb-1">Amount *</label>
                                <input type="number" step="0.01" min="0" name="item_amount[]" required value="<%- Number($item.amount).toFixed(2) %>" oninput="recalcGeneratorBreakdown()" class="w-full bg-[#0F0E0D] border-2 border-bronze px-3 py-2.5 text-base font-mono font-bold text-bronzeLight text-right">
                            </div>
                            <div class="sm:col-span-1 flex sm:justify-end pt-5">
                                <button type="button" onclick="removeGeneratorLineItem(this)" class="px-2.5 py-2 bg-red-950/60 border border-red-600/70 text-red-200 text-[10px] uppercase tracking-widest font-semibold hover:bg-red-700 hover:text-white transition" title="Remove this description from invoice">
                                    ✕ Remove
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Totals Footer Bar (Matches Picture + Fixed 15% VAT) -->
                <div class="border-t-2 border-dashed border-white/30 pt-4 space-y-2 font-mono">
                    <div class="flex justify-between items-center text-sm text-stone px-2">
                        <span>SUBTOTAL (<span id="gen_footer_count">5</span> ACTIVE DESCRIPTION ITEMS)</span>
                        <span id="gen_footer_subtotal" class="text-white font-bold text-base">$9,500.00</span>
                    </div>
                    <div class="flex justify-between items-center text-sm text-bronzeLight px-2">
                        <span>FIXED VAT (15%)</span>
                        <span id="gen_footer_vat" class="font-bold text-base">$1,425.00</span>
                    </div>
                    <div class="border-t-2 border-dashed border-white/30 pt-3 flex justify-between items-center text-lg font-bold text-white px-2">
                        <span>TOTAL DUE (INCL. 15% VAT)</span>
                        <span id="gen_footer_total" class="text-2xl text-bronzeLight">$10,925.00</span>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
                <p class="text-xs text-stone">
                    * Once generated, the invoice opens in print mode and is automatically placed on the Artist’s page with a <strong>Download Invoice Copy</strong> button. You can also add/remove descriptions on any generated invoice anytime below.
                </p>
                <button type="submit" class="bg-bronze text-white px-8 py-3.5 text-xs uppercase tracking-widest font-semibold hover:bg-obsidian transition shadow-sm">
                    🖨 Generate &amp; Print Authentication Invoice →
                </button>
            </div>
        </form>
</div></details>

<details class="adm-acc" open><summary class="adm-acc-sum"><span class="adm-acc-ic">☰</span><span class="adm-acc-t">Issued Authentication Invoices<small>Review, edit, mark paid, download PDF or open the aligned contract</small></span><span class="adm-acc-chev"></span></summary><div class="adm-acc-body">
        <!-- Generated Authentication Invoices Ledger -->
        <div class="border-t border-hairline pt-6 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="font-serif text-2xl text-obsidian">Issued Curatorial &amp; AI Authentication Invoices (<%- count($authInvoices || []) %>)</h3>
            </div>

            <% if (empty($authInvoices)) { %>
                <p class="text-xs text-stone italic">No authentication invoices have been generated yet. Fill out the form above to generate and print your first invoice.</p>
            <% } else { %>
                <div class="overflow-x-auto border border-hairline">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-obsidian text-ivory uppercase tracking-widest text-[10px]">
                                <th class="py-3 px-4">Invoice No.</th>
                                <th class="py-3 px-4">Artist &amp; Details</th>
                                <th class="py-3 px-4">Artwork Verified</th>
                                <th class="py-3 px-4">Receiving Account</th>
                                <th class="py-3 px-4">Fee</th>
                                <th class="py-3 px-4">Status</th>
                                <th class="py-3 px-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-hairline">
                            <% for (const $invRow of Object.values($authInvoices || [])) { %>
                                <tr class="hover:bg-ivory/60">
                                    <td class="py-3.5 px-4 font-mono font-semibold text-obsidian">
                                        <%- e($invRow?.['invoice_number']) %>
                                        <div class="text-[10px] text-stone font-sans">Issued: <%- e(substr($invRow?.['created_at'] ?? '', 0, 10)) %></div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="font-semibold text-obsidian"><%- e($invRow?.['artist_name']) %></div>
                                        <% if (!empty($invRow?.['artist_email'])) { %>
                                            <div class="text-[11px] text-stone"><%- e($invRow?.['artist_email']) %></div>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="font-serif italic text-sm text-obsidian">"<%- e($invRow?.['artwork_title']) %>"</div>
                                        <div class="text-[10px] text-bronze"><%- e($invRow?.['service_type']) %></div>
                                    </td>
                                    <td class="py-3.5 px-4 font-mono text-[11px] space-y-1">
                                        <% if (!empty($invRow?.['payment_account_number']) || !empty($invRow?.['payment_bank_name'])) { %>
                                            <div>
                                                <span class="text-[9px] uppercase tracking-widest bg-obsidian text-ivory px-1.5 py-0.5 mr-1">Bank</span>
                                                <strong class="text-obsidian"><%- e($invRow?.['payment_bank_name']) %></strong>
                                                <div class="text-charcoal"><%- e($invRow?.['payment_account_name']) %> · <%- e($invRow?.['payment_account_number']) %></div>
                                                <% if (!empty($invRow?.['payment_bank_address'])) { %>
                                                    <div class="text-[10px] text-stone font-sans"><%- e($invRow?.['payment_bank_address']) %></div>
                                                <% } %>
                                            </div>
                                        <% } %>
                                        <% if (!empty($invRow?.['crypto_wallet_address']) || !empty($invRow?.['crypto_currency'])) { %>
                                            <div>
                                                <span class="text-[9px] uppercase tracking-widest bg-bronze text-white px-1.5 py-0.5 mr-1">Crypto</span>
                                                <strong class="text-obsidian"><%- e($invRow?.['crypto_currency'] || 'Crypto') %></strong>
                                                <% if (!empty($invRow?.['crypto_network'])) { %>
                                                    <span class="text-stone">(<%- e($invRow?.['crypto_network']) %>)</span>
                                                <% } %>
                                                <div class="text-charcoal break-all"><%- e($invRow?.['crypto_wallet_address']) %></div>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5 px-4 font-mono text-obsidian">
                                        <div class="font-semibold text-sm">
                                            <%- format_money_exact(Number($invRow?.['fee_amount'] ?? 0), $invRow?.['currency'] ?? 'USD') %>
                                        </div>
                                        <% var $rowItems = Array.isArray($invRow?.['line_items']) ? $invRow['line_items'] : []; %>
                                        <div class="text-[10px] text-stone">
                                            <%- $rowItems.length %> item(s) · Sub: <%- format_money_exact(Number($invRow?.['subtotal_amount'] ?? 0), $invRow?.['currency'] ?? 'USD') %> + 15% VAT
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <% if (($invRow?.['status'] ?? 'unpaid') === 'paid') { %>
                                            <span class="bg-[#1A2E22] text-ivory text-[10px] uppercase tracking-widest px-2.5 py-1 font-semibold">✓ Paid</span>
                                        <% } else { %>
                                            <span class="bg-bronze/20 text-bronze border border-bronze text-[10px] uppercase tracking-widest px-2.5 py-1 font-semibold">Unpaid</span>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5 px-4 text-right space-x-1.5 whitespace-nowrap">
                                        <form action="/admin/agreements/from-invoice" method="POST" class="inline">
                                            <%- csrf_field() %>
                                            <input type="hidden" name="invoice_id" value="<%- Number($invRow?.['id']) %>">
                                            <button type="submit" class="px-3 py-1.5 bg-[#181615] text-bronzeLight border border-bronze text-[10px] uppercase tracking-widest font-semibold hover:bg-bronze hover:text-white transition" title="Open or generate the aligned Artist Contract Agreement for this Invoice">
                                                📜 Contract
                                            </button>
                                        </form>
                                        <a href="/invoices/<%- Number($invRow?.['id']) %>?edit=1" class="inline-block px-3 py-1.5 border border-bronze bg-bronze/10 text-bronze text-[10px] uppercase tracking-widest font-semibold hover:bg-bronze hover:text-white transition" title="Add, remove, or edit descriptions and amounts on this invoice">
                                            ✎ Edit Descriptions
                                        </a>
                                        <a href="/invoices/<%- Number($invRow?.['id']) %>?download_pdf=1" target="_blank" class="inline-block px-3 py-1.5 bg-bronze text-white text-[10px] uppercase tracking-widest font-semibold hover:bg-obsidian transition">
                                            ⬇ Download PDF
                                        </a>
                                        <a href="/invoices/<%- Number($invRow?.['id']) %>?print=1" target="_blank" class="inline-block px-3 py-1.5 bg-obsidian text-ivory text-[10px] uppercase tracking-widest hover:bg-bronze transition">
                                            🖨 Print / View
                                        </a>
                                        <a href="/invoices/<%- Number($invRow?.['id']) %>/download" class="inline-block px-3 py-1.5 border border-obsidian text-obsidian text-[10px] uppercase tracking-widest hover:bg-obsidian hover:text-ivory transition">
                                            ⬇ HTML
                                        </a>
                                        <form action="/admin/invoices/status" method="POST" class="inline">
                                            <%- csrf_field() %>
                                            <input type="hidden" name="invoice_id" value="<%- Number($invRow?.['id']) %>">
                                            <button type="submit" class="px-2.5 py-1.5 border border-bronze text-bronze text-[10px] uppercase tracking-widest hover:bg-bronze hover:text-white transition">
                                                <%- ($invRow?.['status'] ?? 'unpaid') === 'paid' ? 'Mark Unpaid' : 'Mark Paid' %>
                                            </button>
                                        </form>
                                        <form action="/admin/invoices/delete" method="POST" class="inline" onsubmit="return confirm('Delete this authentication invoice?');">
                                            <%- csrf_field() %>
                                            <input type="hidden" name="invoice_id" value="<%- Number($invRow?.['id']) %>">
                                            <button type="submit" class="px-2.5 py-1.5 border border-red-800 text-red-800 text-[10px] uppercase tracking-widest hover:bg-red-800 hover:text-white transition">
                                                ✕
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
</div></details>
    </section>
</div>

<div class="adm-panel" data-panel="agreements" data-title="Contract Agreements" data-crumb="Documents">
    <!-- SECTION 0B: Artist Consignment, Authentication & Digital Auction Contract Agreement Generator -->
    <% var $defaultArtistObj = (Array.isArray($allArtistsList) && $allArtistsList.length > 0) ? $allArtistsList[0] : null;
       var $defaultArtistUser = $defaultArtistObj?.['user'] ?? {};
       var $defaultArtistInvoice = $defaultArtistObj?.['latest_invoice'] ?? ((Array.isArray($authInvoices) && $authInvoices.length > 0) ? $authInvoices[0] : null);
       var $defaultAgrLineItems = ($defaultArtistInvoice && Array.isArray($defaultArtistInvoice['line_items']) && $defaultArtistInvoice['line_items'].length > 0)
           ? $defaultArtistInvoice['line_items']
           : $presetList;
       var $defaultAgrArtworksCount = Math.max(1, Number($defaultArtistObj?.['artworks_count'] ?? 1));
    %>
    <section id="agreement-generator" class="bg-white border-2 border-obsidian p-8 space-y-8 shadow-sm">
        <div class="border-b border-hairline pb-5 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <span class="bg-[#181615] text-bronzeLight border border-bronze text-[10px] uppercase tracking-widest px-3 py-1 font-semibold">
                        ✓ ArtAlly Official Letterheaded Paper · Pre-Signed &amp; Sealed by ArtAlly
                    </span>
                    <span class="bg-bronze/15 text-bronze border border-bronze text-[10px] uppercase tracking-widest px-2.5 py-1 font-semibold">
                        15% Platform / 85% Artist Commission · Per-Artwork Auth Fee Aligned with Invoice
                    </span>
                </div>
                <h2 class="font-serif text-3xl text-obsidian mt-2">Artist Consignment, Authentication &amp; Digital Auction Contract Agreement Generator</h2>
            </div>
            <p class="text-xs text-stone max-w-xl">
                Since the artist registers first, their registered details automatically appear below. The authentication descriptions are pulled directly from the artist’s Authentication Invoice so both the Agreement and Invoice align 100%, with the authentication payment calculated <strong>per each artwork</strong> and multiplied by the <strong>total artworks</strong>.
            </p>
        </div>

<details class="adm-acc" open><summary class="adm-acc-sum"><span class="adm-acc-ic">+</span><span class="adm-acc-t">Create New Contract Agreement<small>Auto-fills the registered artist and syncs with the authentication invoice</small></span><span class="adm-acc-chev"></span></summary><div class="adm-acc-body">
        <form action="/admin/agreements/generate" method="POST" class="space-y-8">
            <%- csrf_field() %>

            <!-- Step 1: Select Registered Artist & Aligned Authentication Invoice (Auto-Fills Everything) -->
            <div class="bg-[#181615] text-ivory border border-bronze p-5 grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label class="block text-[10px] uppercase tracking-widest text-bronzeLight font-semibold mb-1.5">
                        1. Registered Artist (Auto-Populates Artist Details &amp; Total Artworks) *
                    </label>
                    <select id="agr_select_artist" name="artist_id" class="w-full border border-bronze bg-obsidian px-3.5 py-2.5 text-xs text-white" onchange="autoFillAgreementFromArtist(this)">
                        <% if (empty($allArtistsList)) { %>
                            <option value="0">— No Registered Artists Yet (Type Artist Details Below) —</option>
                        <% } else { %>
                            <% for (let $aIdx = 0; $aIdx < $allArtistsList.length; $aIdx++) {
                                const $apItem = $allArtistsList[$aIdx];
                                const $apUser = $apItem?.['user'] ?? {};
                                const $apInv = $apItem?.['latest_invoice'] ?? null;
                                const $apRegRef = 'ART-REG-' + gmdate('Y') + '-' + String($apItem?.['user_id'] || 1).padStart(4, '0'); %>
                                <option value="<%- Number($apItem?.['user_id'] || 0) %>"
                                    <%- $aIdx === 0 ? 'selected' : '' %>
                                    data-full-name="<%- e($apUser?.['name'] || $apItem?.['display_name'] || '') %>"
                                    data-prof-name="<%- e($apItem?.['display_name'] || $apUser?.['name'] || '') %>"
                                    data-email="<%- e($apUser?.['email'] || '') %>"
                                    data-country="<%- e($apItem?.['country'] || $apUser?.['country'] || 'Switzerland') %>"
                                    data-address="<%- e(($apItem?.['city'] ? $apItem['city'] + ', ' : '') + ($apItem?.['country'] || $apUser?.['country'] || 'Switzerland')) %>"
                                    data-discipline="<%- e($apItem?.['discipline'] || 'Contemporary Fine Art') %>"
                                    data-reg-ref="<%- e($apRegRef) %>"
                                    data-artworks-count="<%- Math.max(1, Number($apItem?.['artworks_count'] || 1)) %>"
                                    data-latest-invoice-id="<%- Number($apInv?.['id'] || 0) %>">
                                    <%- e($apItem?.['display_name'] || $apUser?.['name']) %> (<%- e($apUser?.['email'] || 'Registered Artist') %> · <%- Math.max(1, Number($apItem?.['artworks_count'] || 1)) %> Artwork(s))
                                </option>
                            <% } %>
                            <option value="0">— Or Enter Custom Artist Details Manually —</option>
                        <% } %>
                    </select>
                </div>

                <div>
                    <label class="block text-[10px] uppercase tracking-widest text-bronzeLight font-semibold mb-1.5">
                        2. Align Authentication Descriptions From Issued Invoice (100% Invoice Sync)
                    </label>
                    <select id="agr_select_invoice" name="invoice_id" class="w-full border border-bronze bg-obsidian px-3.5 py-2.5 text-xs text-white" onchange="autoFillAgreementFromInvoice(this)">
                        <option value="0">— Sync with Artist’s Latest Invoice or Use Active Breakdown Below —</option>
                        <% for (const $invOpt of Object.values($authInvoices || [])) { %>
                            <option value="<%- Number($invOpt?.['id'] || 0) %>"
                                <%- ($defaultArtistInvoice && Number($defaultArtistInvoice['id']) === Number($invOpt?.['id'])) ? 'selected' : '' %>
                                data-artist-id="<%- Number($invOpt?.['artist_id'] || 0) %>"
                                data-artist-name="<%- e($invOpt?.['artist_name'] || '') %>"
                                data-artist-email="<%- e($invOpt?.['artist_email'] || '') %>"
                                data-currency="<%- e($invOpt?.['currency'] || 'USD') %>"
                                data-service="<%- e($invOpt?.['service_type'] || '') %>"
                                data-items='<%- JSON.stringify($invOpt?.['line_items'] || []) %>'>
                                <%- e($invOpt?.['invoice_number']) %> — <%- e($invOpt?.['artist_name']) %> ("<%- e($invOpt?.['artwork_title']) %>" · <%- format_money_exact(Number($invOpt?.['fee_amount'] || 0), $invOpt?.['currency'] || 'USD') %>/artwork)
                            </option>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Column 1: Registered Artist Details (Auto-Appears from Registration) -->
                <div class="border border-hairline p-6 bg-ivory space-y-3.5">
                    <div class="flex items-center justify-between border-b border-hairline pb-2">
                        <p class="text-[11px] uppercase tracking-widest text-bronze font-semibold">
                            1. Registered Artist Details (Auto-Filled)
                        </p>
                        <span class="bg-obsidian text-bronzeLight text-[9px] uppercase tracking-widest px-2 py-0.5 font-semibold">Auto-Synced</span>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Full Legal Name *</label>
                        <input type="text" id="agr_artist_full_name" name="artist_full_name" required value="<%- e($defaultArtistUser?.['name'] || $defaultArtistObj?.['display_name'] || $defaultArtistInvoice?.['artist_name'] || '') %>" placeholder="Registered Artist Full Legal Name" class="w-full border border-hairline bg-white px-3 py-2 text-sm text-obsidian font-semibold">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Professional / Studio Name</label>
                        <input type="text" id="agr_artist_prof_name" name="artist_professional_name" value="<%- e($defaultArtistObj?.['display_name'] || $defaultArtistUser?.['name'] || '') %>" placeholder="Artist Professional / Studio Name" class="w-full border border-hairline bg-white px-3 py-2 text-sm text-obsidian">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Registered Email</label>
                            <input type="email" id="agr_artist_email" name="artist_email" value="<%- e($defaultArtistUser?.['email'] || $defaultArtistInvoice?.['artist_email'] || '') %>" placeholder="artist@studio.com" class="w-full border border-hairline bg-white px-3 py-2 text-xs text-obsidian">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Country</label>
                            <input type="text" id="agr_artist_country" name="artist_country" value="<%- e($defaultArtistObj?.['country'] || $defaultArtistUser?.['country'] || 'Switzerland') %>" placeholder="Country" class="w-full border border-hairline bg-white px-3 py-2 text-xs text-obsidian">
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Registered Studio Address / Location</label>
                        <input type="text" id="agr_artist_address" name="artist_address" value="<%- e(($defaultArtistObj?.['city'] ? $defaultArtistObj['city'] + ', ' : '') + ($defaultArtistObj?.['country'] || $defaultArtistUser?.['country'] || 'Switzerland')) %>" placeholder="City, Studio Address & Country" class="w-full border border-hairline bg-white px-3 py-2 text-xs text-obsidian">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Artistic Discipline</label>
                            <input type="text" id="agr_artist_discipline" name="artist_discipline" value="<%- e($defaultArtistObj?.['discipline'] || 'Contemporary Fine Art') %>" class="w-full border border-hairline bg-white px-3 py-2 text-xs text-obsidian">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Registration ID</label>
                            <input type="text" id="agr_artist_reg_ref" name="artist_registration_ref" value="<%- e('ART-REG-' + gmdate('Y') + '-' + String($defaultArtistObj?.['user_id'] || 1).padStart(4, '0')) %>" class="w-full border border-hairline bg-white px-3 py-2 text-xs font-mono text-obsidian">
                        </div>
                    </div>
                </div>

                <!-- Column 2: Per-Artwork Authentication Payment & Total Artworks Calculator -->
                <div class="border border-hairline p-6 bg-ivory space-y-4">
                    <p class="text-[11px] uppercase tracking-widest text-bronze font-semibold border-b border-hairline pb-2">
                        2. Per-Artwork Auth Payment &amp; Total Artworks
                    </p>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Total Artworks Covered *</label>
                            <input type="number" id="agr_total_artworks" name="total_artworks" min="1" max="500" required value="<%- $defaultAgrArtworksCount %>" oninput="recalcAgreementGenerator()" class="w-full border-2 border-bronze bg-white px-3 py-2 text-base font-mono font-bold text-obsidian">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Currency</label>
                            <select id="agr_currency_select" name="currency" onchange="recalcAgreementGenerator()" class="w-full border border-hairline bg-white px-3 py-2.5 text-xs text-obsidian">
                                <option value="USD">USD ($)</option>
                                <option value="EUR">EUR (€)</option>
                                <option value="GBP">GBP (£)</option>
                                <option value="CHF">CHF (Fr.)</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-charcoal font-semibold mb-1">Authentication Service Protocol (Aligned with Invoice)</label>
                        <input type="text" id="agr_service_type" name="service_type" value="<%- e($defaultArtistInvoice?.['service_type'] || 'Independent Curatorial Connoisseurship & AI-Powered Authentication Evaluation') %>" class="w-full border border-hairline bg-white px-3 py-2 text-xs text-obsidian">
                    </div>

                    <!-- Live Per-Artwork & Total Artworks Summary Box -->
                    <div class="bg-[#181615] text-ivory border border-bronze p-4 space-y-2 font-mono text-xs">
                        <div class="flex justify-between items-center text-stone text-[11px]">
                            <span>Per-Artwork Subtotal (<span id="agr_gen_item_count"><%- $defaultAgrLineItems.length %></span> items):</span>
                            <span id="agr_gen_per_sub" class="text-white font-semibold">$9,500.00</span>
                        </div>
                        <div class="flex justify-between items-center text-stone text-[11px]">
                            <span>Fixed 15% VAT (Per Artwork):</span>
                            <span id="agr_gen_per_vat" class="text-bronzeLight font-semibold">$1,425.00</span>
                        </div>
                        <div class="border-t border-white/15 pt-1.5 flex justify-between items-center text-xs font-bold">
                            <span class="text-ivory">Auth Fee Per 1 Artwork:</span>
                            <span id="agr_gen_per_fee" class="text-bronzeLight">$10,925.00</span>
                        </div>
                        <div class="border-t-2 border-dashed border-bronze/60 pt-2 flex justify-between items-center text-sm font-bold">
                            <span class="text-white uppercase">Total Auth (<span id="agr_gen_art_count"><%- $defaultAgrArtworksCount %></span> Work<span id="agr_gen_art_plural"><%- $defaultAgrArtworksCount === 1 ? '' : 's' %></span>):</span>
                            <span id="agr_gen_grand_total" class="text-bronzeLight text-base">$10,925.00</span>
                        </div>
                    </div>

                    <div class="bg-white border border-hairline p-3 text-[11px] text-stone leading-relaxed">
                        <strong class="text-obsidian block mb-0.5">Percentage Commission Agreement:</strong>
                        Fixed <strong>15% ArtAlly Platform Commission</strong> &amp; <strong>85% Artist Net Share</strong> of the final hammer price, disbursed to the Artist’s Studio Treasury Wallet.
                    </div>
                </div>

                <!-- Column 3: Pre-Signed ArtAlly Letterhead & Legal Terms -->
                <div class="border border-bronze p-6 bg-[#181615] text-ivory space-y-4">
                    <p class="text-[11px] uppercase tracking-widest text-bronzeLight font-semibold border-b border-white/15 pb-2">
                        3. Pre-Signed ArtAlly Letterhead &amp; Signatory
                    </p>
                    <div class="bg-white/5 border border-bronze/50 p-3.5 space-y-1.5 text-xs">
                        <span class="text-[10px] uppercase tracking-widest text-bronzeLight font-bold block">✓ ArtAlly Side Pre-Signed &amp; Sealed</span>
                        <p class="text-stone text-[11px] leading-relaxed">
                            Generated on official <strong>ArtAlly Geneva Letterheaded Paper</strong> with ArtAlly’s executive cursive signature and corporate seal already affixed.
                        </p>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">ArtAlly Authorised Signatory Name</label>
                        <input type="text" name="platform_signatory_name" value="Dr. Henri Vance" class="w-full border border-white/20 bg-white/10 px-3 py-2 text-xs text-white">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Signatory Position / Title</label>
                        <input type="text" name="platform_signatory_title" value="Chief Curatorial Director & Head of Authentication" class="w-full border border-white/20 bg-white/10 px-3 py-2 text-xs text-white">
                    </div>
                    <div class="grid grid-cols-2 gap-2.5">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Exclusivity</label>
                            <select name="exclusivity_type" class="w-full border border-white/20 bg-obsidian px-2.5 py-2 text-xs text-white">
                                <option value="Non-Exclusive">Non-Exclusive</option>
                                <option value="Exclusive">Exclusive Consignment</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Governing Law</label>
                            <input type="text" name="governing_law" value="Laws of Switzerland (Canton of Geneva)" class="w-full border border-white/20 bg-white/10 px-2.5 py-2 text-xs text-white">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Aligned Authentication Descriptions List (Synced with Invoice) -->
            <div class="border-2 border-bronze bg-[#141215] text-ivory p-6 space-y-4">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-white/15 pb-4">
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold">
                            4. Aligned Authentication Descriptions (Pulled From Invoice · Per-Artwork Amounts)
                        </p>
                        <h3 class="font-serif text-2xl text-white mt-0.5">
                            Authentication Protocol Breakdown on Contract Agreement &amp; Invoice
                        </h3>
                        <p class="text-xs text-stone mt-1">
                            These authentication descriptions appear on the Contract Agreement and are automatically kept in sync with the Artist’s Authentication Invoice.
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" onclick="resetDefaultAgreementItems()" class="px-3 py-1.5 border border-bronze text-bronzeLight text-[10px] uppercase tracking-widest font-semibold hover:bg-bronze hover:text-white transition">
                            ↺ Restore Default 5 Descriptions
                        </button>
                        <button type="button" onclick="addAgreementGeneratorItem({ key: 'custom', title: 'Custom Forensic / Authentication Protocol', description: '- Specialized curatorial and AI verification procedure.', amount: 500.00 })" class="px-3 py-1.5 bg-bronze text-white text-[10px] uppercase tracking-widest font-semibold hover:bg-white hover:text-obsidian transition">
                            + Add Custom Description
                        </button>
                    </div>
                </div>

                <div id="agr_generator_items_container" class="space-y-3">
                    <% for (const $aItem of $defaultAgrLineItems) { %>
                        <div class="agr-gen-item-row bg-white/5 border border-white/15 p-4 grid grid-cols-1 sm:grid-cols-12 gap-4 items-start" data-key="<%- e($aItem.key || 'item') %>">
                            <input type="hidden" name="item_key[]" value="<%- e($aItem.key || 'item') %>">
                            <div class="sm:col-span-8 space-y-2">
                                <label class="block text-[9px] uppercase tracking-widest text-bronzeLight font-semibold">Authentication Description Title *</label>
                                <input type="text" name="item_title[]" required value="<%- e($aItem.title) %>" class="w-full bg-[#0F0E0D] border border-white/25 px-3 py-2 text-sm font-mono font-bold text-white">
                                <label class="block text-[9px] uppercase tracking-widest text-stone font-semibold">Forensic Protocol Sub-Bullets</label>
                                <textarea name="item_description[]" rows="2" class="w-full bg-[#0F0E0D] border border-white/15 px-3 py-2 text-xs font-mono text-stone leading-relaxed"><%- e($aItem.description) %></textarea>
                            </div>
                            <div class="sm:col-span-3">
                                <label class="block text-[9px] uppercase tracking-widest text-bronzeLight font-semibold sm:text-right mb-1">Per-Artwork Fee *</label>
                                <input type="number" step="0.01" min="0" name="item_amount[]" required value="<%- Number($aItem.amount || 0).toFixed(2) %>" oninput="recalcAgreementGenerator()" class="w-full bg-[#0F0E0D] border-2 border-bronze px-3 py-2.5 text-base font-mono font-bold text-bronzeLight text-right">
                            </div>
                            <div class="sm:col-span-1 flex sm:justify-end pt-5">
                                <button type="button" onclick="removeAgreementGeneratorItem(this)" class="px-2.5 py-2 bg-red-950/60 border border-red-600/70 text-red-200 text-[10px] uppercase tracking-widest font-semibold hover:bg-red-700 hover:text-white transition">
                                    ✕ Remove
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
                <p class="text-xs text-stone">
                    * Clicking <strong>Generate &amp; Print Contract Agreement</strong> issues the official contract on ArtAlly Letterheaded Paper (already signed by ArtAlly) and places a copy on the Artist’s Dashboard and Artist Page.
                </p>
                <button type="submit" class="bg-[#181615] text-bronzeLight border-2 border-bronze px-8 py-3.5 text-xs uppercase tracking-widest font-semibold hover:bg-bronze hover:text-white transition shadow-sm">
                    📜 Generate &amp; Print Pre-Signed Contract Agreement →
                </button>
            </div>
        </form>
</div></details>

