                                <!-- Direct Wallet Balance Credit / Adjustment -->
                                <form action="/admin/artists/wallet-access" method="POST" class="flex items-center gap-1.5">
                                    <%- csrf_field() %>
                                    <input type="hidden" name="artist_profile_id" value="<%- Number($ap?.['id']) %>">
