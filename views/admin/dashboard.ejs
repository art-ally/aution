var $admAgrCount = count($contractAgreements || []);
var $admInitial = String(($admin && $admin['name']) ? $admin['name'] : 'A').trim().charAt(0).toUpperCase();
%>
<style>
/* ===== ArtAlly Admin Console — layout & premium UI (presentation only) ===== */
.adm-shell { display: flex; min-height: 100vh; background: #F4F1EB; color: #161514; font-family: 'Plus Jakarta Sans', sans-serif; }
.adm-side { width: 272px; flex-shrink: 0; background: linear-gradient(180deg, #14110F 0%, #1B1714 100%); color: #CFC8BC; position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; border-right: 1px solid rgba(198,166,100,.18); z-index: 60; }
.adm-side::-webkit-scrollbar { width: 5px; }
.adm-side::-webkit-scrollbar-thumb { background: rgba(198,166,100,.3); }
.adm-brand { padding: 1.6rem 1.4rem 1.1rem; border-bottom: 1px solid rgba(255,255,255,.07); }
.adm-brand-mark { display: flex; align-items: center; gap: .8rem; }
.adm-brand-logo { width: 40px; height: 40px; border: 1.5px solid #C6A664; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 700; font-size: 1.25rem; color: #C6A664; letter-spacing: .05em; background: rgba(198,166,100,.08); border-radius: 10px; }
.adm-brand-name { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.45rem; letter-spacing: .2em; color: #FBF9F5; font-weight: 600; line-height: 1; }
.adm-brand-sub { font-size: .58rem; letter-spacing: .26em; text-transform: uppercase; color: #C6A664; margin-top: .3rem; }
.adm-search { margin: 1rem 1.1rem .4rem; position: relative; }
.adm-search input { width: 100%; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); color: #FBF9F5; padding: .6rem .8rem .6rem 2rem; font-size: .75rem; border-radius: 10px; outline: none; transition: border-color .2s, background .2s; }
.adm-search input::placeholder { color: #8F887C; }
.adm-search input:focus { border-color: #C6A664; background: rgba(255,255,255,.09); }
.adm-search span { position: absolute; left: .7rem; top: 50%; transform: translateY(-50%); font-size: .75rem; color: #8F887C; }
.adm-nav { padding: .6rem .8rem 1rem; flex: 1; }
.adm-group { margin-bottom: .25rem; }
.adm-group > summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; padding: .7rem .6rem; font-size: .62rem; text-transform: uppercase; letter-spacing: .22em; color: #9A9285; font-weight: 700; user-select: none; border-radius: 8px; transition: color .2s; }
.adm-group > summary::-webkit-details-marker { display: none; }
.adm-group > summary:hover { color: #C6A664; }
.adm-group > summary::after { content: ''; width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); transition: transform .2s; }
.adm-group[open] > summary::after { transform: rotate(45deg); }
.adm-link { display: flex; align-items: center; gap: .7rem; padding: .62rem .75rem; margin: 1px 0; font-size: .8rem; color: #D8D2C6; border-radius: 10px; text-decoration: none; transition: background .18s, color .18s, transform .18s; border: 1px solid transparent; }
.adm-link:hover { background: rgba(255,255,255,.07); color: #FFFFFF; }
.adm-link.is-active { background: linear-gradient(90deg, rgba(198,166,100,.22), rgba(198,166,100,.06)); color: #FFFFFF; border-color: rgba(198,166,100,.35); font-weight: 600; }
.adm-link .ic { width: 22px; text-align: center; font-size: .95rem; flex-shrink: 0; }
.adm-link .lbl { flex: 1; }
.adm-badge { font-size: .62rem; font-weight: 700; padding: .12rem .5rem; border-radius: 99px; background: rgba(255,255,255,.1); color: #E9E3D6; min-width: 1.4rem; text-align: center; }
.adm-badge.warn { background: #C6A664; color: #14110F; }
.adm-side-foot { padding: 1rem 1.1rem 1.4rem; border-top: 1px solid rgba(255,255,255,.07); }
.adm-user { display: flex; align-items: center; gap: .7rem; margin-bottom: .8rem; }
.adm-avatar { width: 38px; height: 38px; border-radius: 50%; background: #C6A664; color: #14110F; font-weight: 700; display: flex; align-items: center; justify-content: center; font-size: .95rem; flex-shrink: 0; }
.adm-user-n { font-size: .8rem; color: #FBF9F5; font-weight: 600; line-height: 1.2; }
.adm-user-e { font-size: .65rem; color: #9A9285; word-break: break-all; }
.adm-foot-btns { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
.adm-foot-btns a, .adm-foot-btns button { text-align: center; font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; padding: .6rem .4rem; border-radius: 9px; border: 1px solid rgba(255,255,255,.18); color: #E9E3D6; background: transparent; cursor: pointer; transition: all .2s; text-decoration: none; width: 100%; }
.adm-foot-btns a:hover, .adm-foot-btns button:hover { background: #C6A664; color: #14110F; border-color: #C6A664; }

.adm-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.adm-top { position: sticky; top: 0; z-index: 40; background: rgba(244,241,235,.92); backdrop-filter: blur(10px); border-bottom: 1px solid #E4DDD0; padding: .9rem 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.adm-top-l { display: flex; align-items: center; gap: .9rem; min-width: 0; }
.adm-burger { display: none; width: 40px; height: 40px; border: 1px solid #D9D1C2; background: #fff; border-radius: 10px; cursor: pointer; font-size: 1.1rem; }
.adm-crumb { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; color: #8C6D46; font-weight: 700; }
.adm-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.7rem; line-height: 1.1; color: #161514; font-weight: 600; }
.adm-top-r { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
.adm-btn { font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 600; padding: .6rem 1rem; border-radius: 10px; border: 1px solid #D9D1C2; background: #fff; color: #161514; cursor: pointer; transition: all .2s; text-decoration: none; display: inline-flex; align-items: center; gap: .4rem; }
.adm-btn:hover { background: #161514; color: #FBF9F5; border-color: #161514; }
.adm-btn.gold { background: #8C6D46; color: #fff; border-color: #8C6D46; }
.adm-btn.gold:hover { background: #161514; border-color: #161514; }
.adm-content { padding: 1.8rem 2rem 3rem; max-width: 1500px; width: 100%; margin: 0 auto; }

.adm-panel { display: none; }
.adm-panel.is-active { display: block; animation: admFade .28s ease; }
@keyframes admFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

/* Overview */
.adm-hero { background: linear-gradient(120deg, #14110F, #2A221B 70%); color: #FBF9F5; border-radius: 18px; padding: 1.8rem 2rem; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; border: 1px solid rgba(198,166,100,.35); box-shadow: 0 18px 40px -24px rgba(20,17,15,.6); }
.adm-hero small { font-size: .62rem; letter-spacing: .24em; text-transform: uppercase; color: #C6A664; font-weight: 700; }
.adm-hero h2 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2rem; margin: .3rem 0 .2rem; font-weight: 600; }
.adm-hero p { font-size: .78rem; color: #CFC8BC; max-width: 38rem; }
.adm-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; margin: 1.4rem 0; }
.adm-kpi { background: #fff; border: 1px solid #E7E1D6; border-radius: 16px; padding: 1.15rem 1.25rem; box-shadow: 0 1px 2px rgba(20,17,15,.04), 0 10px 26px -18px rgba(20,17,15,.2); position: relative; overflow: hidden; transition: transform .2s, box-shadow .2s; }
.adm-kpi:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -16px rgba(20,17,15,.3); }
.adm-kpi::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: #C6A664; }
.adm-kpi .k { font-size: .62rem; text-transform: uppercase; letter-spacing: .18em; color: #7A746A; font-weight: 600; }
.adm-kpi .v { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.15rem; font-weight: 600; margin-top: .3rem; color: #161514; line-height: 1.05; }
.adm-kpi .v.gold { color: #8C6D46; }
.adm-kpi .v.sm { font-size: 1.65rem; }
.adm-h3 { font-size: .68rem; text-transform: uppercase; letter-spacing: .22em; color: #8C6D46; font-weight: 700; margin: 1.8rem 0 .8rem; }
.adm-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem; }
.adm-tile { background: #fff; border: 1px solid #E7E1D6; border-radius: 16px; padding: 1.2rem 1.3rem; display: flex; gap: 1rem; align-items: flex-start; text-decoration: none; color: inherit; transition: all .2s; position: relative; }
.adm-tile:hover { border-color: #C6A664; transform: translateY(-2px); box-shadow: 0 16px 32px -20px rgba(20,17,15,.35); }
.adm-tile .ti { width: 44px; height: 44px; border-radius: 12px; background: #F4EEE2; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
.adm-tile .tt { font-weight: 700; font-size: .88rem; color: #161514; }
.adm-tile .td { font-size: .72rem; color: #7A746A; margin-top: .2rem; line-height: 1.45; }
.adm-tile .tb { position: absolute; top: .9rem; right: 1rem; font-size: .65rem; font-weight: 700; background: #161514; color: #C6A664; border-radius: 99px; padding: .15rem .55rem; }
.adm-tile .tb.warn { background: #C6A664; color: #14110F; }
.adm-data { background: #fff; border: 1px solid #E7E1D6; border-radius: 16px; padding: 1.2rem 1.4rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; align-items: center; border-left: 4px solid #991B1B; }
.adm-data .dbadge { background: #1A2E22; color: #E9E3D6; font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; padding: .25rem .65rem; border-radius: 99px; font-weight: 700; }

/* Re-skin existing section cards (presentation only) */
.adm-content section.bg-white, .adm-content #settings > div, .adm-content #users { border-radius: 18px; border: 1px solid #E7E1D6; box-shadow: 0 1px 2px rgba(20,17,15,.04), 0 14px 34px -22px rgba(20,17,15,.22); }
.adm-content section.border-2 { border-width: 1px; }
.adm-content section + section, .adm-content .adm-panel > * + * { margin-top: 1.4rem; }
.adm-content section h2.text-3xl { font-size: 1.7rem; line-height: 1.15; }
.adm-content table thead tr { background: #F6F2EA; }
.adm-content .overflow-x-auto { border-radius: 12px; }
.adm-content input:not([type=checkbox]):not([type=radio]):not([type=hidden]), .adm-content select, .adm-content textarea { border-radius: 8px; }
.adm-content button, .adm-content a.inline-block { border-radius: 8px; }

/* Collapsible accordions (generators & ledgers) */
.adm-acc { border: 1px solid #E7E1D6; border-radius: 16px; background: #FCFBF8; overflow: hidden; }
.adm-acc + .adm-acc { margin-top: 1.2rem; }
.adm-acc-sum { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 1rem; padding: 1rem 1.3rem; background: linear-gradient(90deg, #F6F1E6, #FBF9F5); user-select: none; transition: background .2s; }
.adm-acc-sum::-webkit-details-marker { display: none; }
.adm-acc-sum:hover { background: #F2EBDC; }
.adm-acc-ic { width: 34px; height: 34px; border-radius: 10px; background: #161514; color: #C6A664; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; }
.adm-acc-t { flex: 1; font-weight: 700; font-size: .92rem; color: #161514; }
.adm-acc-t small { display: block; font-weight: 400; font-size: .72rem; color: #7A746A; margin-top: .1rem; }
.adm-acc-chev { width: 9px; height: 9px; border-right: 2px solid #8C6D46; border-bottom: 2px solid #8C6D46; transform: rotate(-45deg); transition: transform .2s; margin-right: .3rem; }
.adm-acc[open] > .adm-acc-sum .adm-acc-chev { transform: rotate(45deg); }
.adm-acc-body { padding: 1.5rem; border-top: 1px solid #E7E1D6; background: #fff; }

/* Fold-able cards (artist cards, wallet panels, platform cards) */
.adm-sub > :first-child { cursor: pointer; position: relative; padding-right: 2.6rem; }
.adm-sub > :first-child::after { content: ''; position: absolute; right: .9rem; top: 50%; width: 9px; height: 9px; border-right: 2px solid #8C6D46; border-bottom: 2px solid #8C6D46; transform: translateY(-70%) rotate(45deg); transition: transform .2s; pointer-events: none; }
.adm-sub.is-folded > :first-child::after { transform: translateY(-50%) rotate(-45deg); }
.adm-sub.is-folded > :not(:first-child) { display: none !important; }
.adm-sub.is-folded { padding-bottom: 1.5rem; }

.adm-overlay { display: none; }
@media (max-width: 1023px) {
  .adm-burger { display: inline-flex; align-items: center; justify-content: center; }
  .adm-side { position: fixed; left: 0; top: 0; transform: translateX(-102%); transition: transform .28s ease; width: 290px; box-shadow: 20px 0 50px -20px rgba(0,0,0,.6); }
  .adm-side.is-open { transform: none; }
  .adm-overlay.is-open { display: block; position: fixed; inset: 0; background: rgba(20,17,15,.55); z-index: 55; }
  .adm-top { padding: .8rem 1rem; }
  .adm-content { padding: 1.2rem 1rem 2.5rem; }
  .adm-title { font-size: 1.35rem; }
}
@media (max-width: 640px) {
  .adm-content section.p-8 { padding: 1.1rem; }
  .adm-hero { padding: 1.3rem; }
}
</style>
<noscript><style>.adm-panel { display: block !important; }</style></noscript>

<div class="adm-shell">
