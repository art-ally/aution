                        </div>

                        <!-- Artist Studio Wallet & Backend Withdrawal Access Control Bar -->
                        <% var $apWallet = $ap?.['wallet_state'] ?? {};
                           var $apBal = Number($apWallet?.['available_balance'] ?? 0);
                           var $apProc = Number($apWallet?.['processing_withdrawals_total'] ?? 0);
                           var $apUnlocked = Boolean($apWallet?.['withdrawal_unlocked'] ?? $ap?.['withdrawal_unlocked'] ?? false); %>
                        <div class="bg-[#181615] text-ivory border border-bronze p-4 sm:p-5 flex flex-col xl:flex-row xl:items-center justify-between gap-4 text-xs">
                            <div class="space-y-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="bg-bronze text-white text-[9px] uppercase tracking-widest px-2.5 py-0.5 font-bold">
                                        💰 Artist Studio Wallet &amp; Withdrawal Gate
                                    </span>
                                    <% if ($apUnlocked) { %>
                                        <span class="bg-[#1A2E22] border border-bronze/50 text-ivory text-[9px] uppercase tracking-widest px-2.5 py-0.5 font-semibold">
                                            🔓 Withdraw Button: UNLOCKED (Artist Can Withdraw)
                                        </span>
                                    <% } else { %>
                                        <span class="bg-white/10 border border-white/25 text-stone text-[9px] uppercase tracking-widest px-2.5 py-0.5 font-semibold">
                                            🔒 Withdraw Button: LOCKED BY DEFAULT
                                        </span>
                                    <% } %>
                                </div>
                                <p class="text-stone text-[11px]">
                                    Available Wallet Balance: <strong class="font-mono text-base text-bronzeLight"><%- format_money_exact($apBal) %></strong>
                                    <% if ($apProc > 0) { %>
                                        · <span class="text-white">Withdrawal Processing (2–7 Days): <strong class="font-mono text-bronzeLight"><%- format_money_exact($apProc) %></strong></span>
                                    <% } %>
                                </p>
                            </div>

                            <div class="flex flex-wrap items-center gap-2.5">
                                <!-- Explicit Unlock & Lock Withdraw Buttons (Backend Control) -->
                                <form action="/admin/artists/wallet-access" method="POST" class="inline-flex items-center gap-2">
                                    <%- csrf_field() %>
                                    <input type="hidden" name="artist_profile_id" value="<%- Number($ap?.['id']) %>">
                                    <input type="hidden" name="artist_id" value="<%- Number($ap?.['user_id']) %>">
                                    <input type="hidden" name="return_anchor" value="#artists">
                                    <button
                                        type="submit"
                                        name="action_type"
                                        value="unlock"
                                        class="px-3.5 py-2 text-[10px] uppercase tracking-widest font-semibold transition <%- $apUnlocked ? 'bg-[#1A2E22] border-2 border-bronze text-ivory shadow-sm' : 'bg-white/10 border border-bronze text-ivory hover:bg-[#1A2E22]' %>"
                                    >
                                        <%- $apUnlocked ? '✓ 🔓 Withdraw UNLOCKED' : '🔓 Unlock Withdraw' %>
                                    </button>
                                    <button
                                        type="submit"
                                        name="action_type"
                                        value="lock"
