<div class="max-w-[1440px] mx-auto px-4 sm:px-8 py-12">
    <!-- Top Studio Header -->
    <div class="border-b border-hairline pb-8 mb-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="flex items-center space-x-5">
            <img src="<%- e($profile?.['profile_photo']) %>" alt="<%- e($profile?.['display_name']) %>" class="w-20 h-20 object-cover border border-hairline">
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <p class="text-[11px] uppercase tracking-widest text-bronze font-semibold">Artist Studio Portal</p>
                    <% if (($profile?.['approval_status'] ?? 'pending') === 'approved') { %>
                        <span class="px-2.5 py-0.5 text-[10px] uppercase tracking-widest bg-[#1A2E22] text-ivory font-semibold">✓ Profile Approved &amp; Live</span>
                    <% } else { %>
                        <span class="px-2.5 py-0.5 text-[10px] uppercase tracking-widest bg-bronze text-white font-semibold">◷ Profile Awaiting Admin Approval</span>
                    <% } %>
                </div>
                <h1 class="font-serif text-4xl text-obsidian mt-1"><%- e($profile?.['display_name']) %></h1>
                <p class="text-xs text-stone mt-1"><%- e($profile?.['discipline']) %> · <%- e($profile?.['country']) %> · Registered Email: <%- e($user?.['email']) %></p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a href="#artist-wallet" class="border border-bronze bg-[#181615] text-bronzeLight px-5 py-3.5 text-xs uppercase tracking-widest font-semibold hover:bg-bronze hover:text-white transition">
                💰 Wallet Balance: <%- format_money_exact(Number($walletState?.['available_balance'] ?? 0)) %>
            </a>
            <a href="/artist/submit" class="bg-obsidian text-ivory px-6 py-3.5 text-xs uppercase tracking-widest font-semibold hover:bg-bronze transition">
                + Upload &amp; Submit New Artwork
            </a>
            <a href="/artist/profile" class="border border-obsidian text-obsidian px-5 py-3.5 text-xs uppercase tracking-widest hover:bg-obsidian hover:text-ivory transition">
                Edit Studio Profile
            </a>
            <form action="/logout" method="POST" class="inline">
                <%- csrf_field() %>
                <button type="submit" class="border border-red-800/40 bg-white text-red-800 px-5 py-3.5 text-xs uppercase tracking-widest hover:bg-red-800 hover:text-white transition">
                    Sign Out
                </button>
            </form>
        </div>
    </div>

    <!-- Artist Studio Treasury Wallet & Withdrawal Center -->
    <% var $walletBal = Number($walletState?.['available_balance'] ?? 0);
       var $walletDisbursed = Number($walletState?.['total_disbursed'] ?? 0);
       var $walletPending = Number($walletState?.['pending_payouts_total'] ?? 0);
       var $walletProcessing = Number($walletState?.['processing_withdrawals_total'] ?? 0);
       var $withdrawUnlocked = Boolean($walletState?.['withdrawal_unlocked'] ?? false);
       var $withdrawalsList = $walletWithdrawals ?? []; %>
    <div id="artist-wallet" class="bg-[#181615] text-ivory border-2 border-bronze p-6 sm:p-8 mb-10 space-y-6 shadow-sm" x-data="{
        showWithdrawForm: false,
        payoutMethod: 'bank_wire'
    }">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 border-b border-white/15 pb-6">
            <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2.5">
                    <span class="bg-bronze text-white text-[10px] uppercase tracking-widest px-3 py-1 font-bold">
                        🏛 Artist Studio Treasury &amp; Disbursed Proceeds Wallet
                    </span>
                    <% if ($withdrawUnlocked) { %>
                        <span class="bg-[#1A2E22] border border-bronze/60 text-ivory text-[10px] uppercase tracking-widest px-3 py-1 font-semibold">
                            🔓 Withdrawal Access Granted by Administration
                        </span>
                    <% } else { %>
                        <span class="bg-white/10 border border-white/25 text-stone text-[10px] uppercase tracking-widest px-3 py-1 font-semibold">
                            🔒 Withdraw Locked by Default (Awaiting Backend Authorization)
                        </span>
                    <% } %>
                </div>
                <h2 class="font-serif text-3xl sm:text-4xl text-ivory">Your Available Wallet Balance</h2>
                <p class="text-xs text-stone max-w-2xl">
                    When ArtAlly Administration clicks <strong>Authorize Wire Payout</strong> on your sold works, the disbursed proceeds are credited directly to your Studio Wallet below. Once withdrawal access is granted from the backend, click <strong>Withdraw Funds</strong> to remit via <strong>Bank Wire</strong> or <strong>Cryptocurrency</strong>.
                </p>
            </div>

            <div class="bg-obsidian border border-bronze p-5 sm:p-6 min-w-[280px] flex flex-col justify-between space-y-4">
                <div>
                    <span class="block text-[10px] uppercase tracking-widest text-bronzeLight font-semibold">Available Wallet Balance</span>
                    <span class="font-serif text-4xl font-bold text-white block mt-1">
                        <%- format_money_exact($walletBal) %> <span class="text-xs font-mono text-bronzeLight">USD</span>
                    </span>
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-stone mt-2 pt-2 border-t border-white/10">
                        <span>Total Disbursed: <strong class="text-ivory"><%- format_money_exact($walletDisbursed) %></strong></span>
                        <span>Pending Release: <strong class="text-ivory"><%- format_money_exact($walletPending) %></strong></span>
                    </div>
                </div>

                <% if ($withdrawUnlocked) { %>
                    <button
                        type="button"
                        @click="showWithdrawForm = !showWithdrawForm"
                        onclick="var panel = document.getElementById('artist-withdraw-form-panel'); if (panel && !window.Alpine) { panel.style.display = panel.style.display === 'none' ? 'block' : 'none'; }"
                        class="w-full bg-bronze text-white py-3.5 px-5 text-xs uppercase tracking-widest font-semibold hover:bg-bronzeDark transition text-center shadow-sm"
                    >
                        <span x-text="showWithdrawForm ? '✕ Close Withdrawal Form' : '🔓 Withdraw Funds Now →'">🔓 Withdraw Funds Now →</span>
                    </button>
                    <p class="text-[10px] text-bronzeLight leading-relaxed">
                        ✓ Withdrawal access is unlocked by Administration. Click above to enter your Bank Wire or Cryptocurrency details.
                    </p>
                <% } else { %>
                    <button
                        type="button"
                        disabled
                        title="Withdrawal (Locked)"
                        class="w-full bg-white/10 border border-white/25 text-stone py-3.5 px-4 text-[11px] uppercase tracking-widest font-semibold cursor-not-allowed flex items-center justify-center gap-2"
                    >
                        <span>Withdrawal (Locked)</span>
                    </button>
                    <p class="text-[10px] text-stone leading-relaxed">
                        * Your Withdraw button is locked by default for security. Once Administration grants withdrawal access from the backend, you can enter your Crypto or Bank Wire details here.
                    </p>
                <% } %>
            </div>
        </div>

        <!-- Interactive Withdrawal Form (Shown when Unlocked & Artist clicks Withdraw) -->
        <% if ($withdrawUnlocked) { %>
        <div id="artist-withdraw-form-panel" x-show="showWithdrawForm" style="display: none;" class="bg-obsidian border border-bronze p-6 space-y-5 text-xs">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/15 pb-4">
                <div>
                    <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold">Official Studio Treasury Remittance</p>
                    <h3 class="font-serif text-2xl text-white mt-0.5">Submit Withdrawal Details (Bank Wire or Cryptocurrency)</h3>
                </div>
                <span class="text-[11px] font-mono text-bronzeLight">
                    Max Available: <%- format_money_exact($walletBal) %> USD
                </span>
            </div>

            <form action="/artist/wallet/withdraw" method="POST" class="space-y-5">
                <%- csrf_field() %>
                <input type="hidden" name="return_to" value="/artist/dashboard#artist-wallet">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-bronzeLight font-semibold mb-1.5">Amount to Withdraw (USD) *</label>
                        <input
                            type="number"
                            step="0.01"
                            min="1"
                            max="<%- $walletBal %>"
                            name="amount"
                            value="<%- $walletBal %>"
                            required
                            class="w-full bg-white/10 border border-bronze px-4 py-3 text-base font-mono font-bold text-white"
                        >
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-bronzeLight font-semibold mb-1.5">Select Receiving Payout Method *</label>
                        <div class="grid grid-cols-2 gap-2.5">
                            <button
                                type="button"
                                @click="payoutMethod = 'bank_wire'"
                                :class="payoutMethod === 'bank_wire' ? 'bg-bronze text-white border-bronze' : 'bg-white/5 text-stone border-white/20 hover:border-white/50'"
                                class="py-3 px-3 border text-[11px] uppercase tracking-widest font-semibold transition"
                            >
                                🏛 Bank Wire Transfer
                            </button>
                            <button
                                type="button"
                                @click="payoutMethod = 'crypto'"
                                :class="payoutMethod === 'crypto' ? 'bg-bronze text-white border-bronze' : 'bg-white/5 text-stone border-white/20 hover:border-white/50'"
                                class="py-3 px-3 border text-[11px] uppercase tracking-widest font-semibold transition"
                            >
                                ₿ Cryptocurrency
                            </button>
                        </div>
                        <input type="hidden" name="payout_method" :value="payoutMethod">
                    </div>
                </div>

                <!-- Option 1: Bank Wire Details -->
                <div x-show="payoutMethod === 'bank_wire'" class="border border-white/15 bg-white/5 p-5 space-y-4">
                    <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold">
                        🏛 Receiving Bank Wire Account Details
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Beneficiary / Account Holder Name *</label>
                            <input type="text" name="bank_account_name" :required="payoutMethod === 'bank_wire'" value="<%- e($profile?.['display_name'] ?? $user?.['name'] ?? '') %>" placeholder="Full Legal or Studio Account Name" class="w-full bg-white/10 border border-white/20 px-3.5 py-2.5 text-white placeholder-white/40">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Bank / Financial Institution Name *</label>
                            <input type="text" name="bank_name" :required="payoutMethod === 'bank_wire'" placeholder="e.g., UBS, Chase, Barclays, Deutsche Bank" class="w-full bg-white/10 border border-white/20 px-3.5 py-2.5 text-white placeholder-white/40">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Account Number / IBAN *</label>
                            <input type="text" name="bank_account_number" :required="payoutMethod === 'bank_wire'" placeholder="Account Number or IBAN" class="w-full bg-white/10 border border-bronze px-3.5 py-2.5 font-mono text-bronzeLight placeholder-white/40">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Routing / SWIFT / BIC Code *</label>
                            <input type="text" name="bank_routing_swift" placeholder="SWIFT / BIC / ABA Routing Number" class="w-full bg-white/10 border border-white/20 px-3.5 py-2.5 font-mono text-white placeholder-white/40">
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Bank Address / Branch Location</label>
                        <input type="text" name="bank_address" placeholder="Street Address, City, Postal Code & Country of Bank Branch" class="w-full bg-white/10 border border-white/20 px-3.5 py-2.5 text-white placeholder-white/40">
                    </div>
                </div>

                <!-- Option 2: Cryptocurrency Details -->
                <div x-show="payoutMethod === 'crypto'" x-cloak class="border border-bronze/60 bg-bronze/10 p-5 space-y-4">
                    <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold">
                        ₿ Receiving Cryptocurrency Wallet Details
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Cryptocurrency / Coin *</label>
                            <input type="text" name="crypto_currency" :required="payoutMethod === 'crypto'" list="artist_crypto_coins" placeholder="e.g., USDT (Tether), USDC, BTC, ETH" class="w-full bg-white/10 border border-white/20 px-3.5 py-2.5 text-white placeholder-white/40">
                            <datalist id="artist_crypto_coins">
                                <option value="USDT (Tether)">
                                <option value="USDC (USD Coin)">
                                <option value="BTC (Bitcoin)">
                                <option value="ETH (Ethereum)">
                                <option value="SOL (Solana)">
                            </datalist>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Blockchain Network *</label>
                            <input type="text" name="crypto_network" :required="payoutMethod === 'crypto'" list="artist_crypto_networks" placeholder="e.g., ERC-20, TRC-20, Bitcoin Mainnet, BEP-20" class="w-full bg-white/10 border border-white/20 px-3.5 py-2.5 text-white placeholder-white/40">
                            <datalist id="artist_crypto_networks">
                                <option value="ERC-20 (Ethereum)">
                                <option value="TRC-20 (Tron)">
                                <option value="Bitcoin Mainnet">
                                <option value="BEP-20 (BNB Smart Chain)">
                                <option value="Solana (SPL)">
                            </datalist>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Receiving Crypto Wallet Address *</label>
                        <input type="text" name="crypto_wallet_address" :required="payoutMethod === 'crypto'" placeholder="Paste your exact receiving wallet address (0x... / T... / bc1q...)" class="w-full bg-white/10 border border-bronze px-3.5 py-2.5 font-mono text-bronzeLight placeholder-white/40">
                    </div>
                    <div>
                        <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Destination Tag / Memo (Optional)</label>
                        <input type="text" name="crypto_memo" placeholder="Optional Memo or Tag if required by your exchange" class="w-full bg-white/10 border border-white/20 px-3.5 py-2.5 font-mono text-white placeholder-white/40">
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] uppercase tracking-widest text-stone mb-1">Additional Remittance Notes (Optional)</label>
                    <input type="text" name="artist_notes" placeholder="Any special clearing instructions for ArtAlly Treasury..." class="w-full bg-white/10 border border-white/20 px-3.5 py-2.5 text-white placeholder-white/40">
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2 border-t border-white/15">
                    <p class="text-[11px] text-stone">
                        ⏱ Standard clearing &amp; settlement timeframe: <strong class="text-bronzeLight">2 to 7 business days</strong> to complete.
                    </p>
                    <button type="submit" class="bg-bronze text-white px-8 py-3.5 text-xs uppercase tracking-widest font-semibold hover:bg-bronzeDark transition">
                        ✓ Confirm &amp; Submit Withdrawal →
                    </button>
                </div>
            </form>
        </div>
        <% } %>

        <!-- Withdrawal Processing & History Status Section -->
        <% if (!empty($withdrawalsList)) { %>
        <div class="space-y-3 pt-2 border-t border-white/15">
            <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold">
                Your Submitted Withdrawal Requests &amp; Settlement Status
            </p>
            <% for (const $wd of Object.values($withdrawalsList || [])) { %>
                <% var $wdStatus = $wd?.['status'] ?? 'processing'; %>
                <div class="border <%- $wdStatus === 'processing' ? 'border-bronze bg-bronze/15' : ($wdStatus === 'completed' ? 'border-[#2D6A4F] bg-[#1A2E22]/60' : 'border-white/20 bg-white/5') %> p-5 space-y-3 text-xs">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="space-y-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-mono text-xs font-bold text-white bg-obsidian px-2.5 py-1 border border-bronze/50">
                                    <%- e($wd?.['reference_code']) %>
                                </span>
                                <% if ($wdStatus === 'processing') { %>
                                    <span class="bg-bronze text-white text-[10px] uppercase tracking-widest px-3 py-1 font-bold">
                                        ⟳ WITHDRAWAL PROCESSING — TAKES 2 TO 7 BUSINESS DAYS TO COMPLETE
                                    </span>
                                <% } else if ($wdStatus === 'completed') { %>
                                    <span class="bg-[#1A2E22] text-ivory border border-bronze/50 text-[10px] uppercase tracking-widest px-3 py-1 font-bold">
                                        ✓ WITHDRAWAL COMPLETED
                                    </span>
                                <% } else { %>
                                    <span class="bg-red-900/60 text-white text-[10px] uppercase tracking-widest px-3 py-1 font-semibold">
                                        ↺ RETURNED TO WALLET
                                    </span>
                                <% } %>
                                <span class="text-[11px] text-stone">Submitted: <%- e($wd?.['created_at']) %> UTC</span>
                            </div>

                            <% if ($wdStatus === 'processing') { %>
                                <p class="text-sm text-ivory font-medium pt-1">
                                    <strong>Withdrawal Processing:</strong> Your withdrawal request of <strong><%- format_money_exact(Number($wd?.['amount'] ?? 0)) %></strong> has been transmitted to ArtAlly Treasury &amp; Clearing. It will take <strong>2 to 7 business days</strong> to complete.
                                </p>
                            <% } %>
                        </div>

                        <div class="text-left sm:text-right whitespace-nowrap">
                            <span class="block text-[10px] uppercase tracking-widest text-stone">Withdrawal Amount</span>
                            <span class="font-serif text-2xl font-bold text-bronzeLight">
                                <%- format_money_exact(Number($wd?.['amount'] ?? 0)) %> <span class="text-xs font-mono">USD</span>
                            </span>
                        </div>
                    </div>

                    <!-- Submitted Bank Wire or Crypto Details -->
                    <div class="bg-obsidian/80 border border-white/10 p-3.5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-[11px]">
                        <% if (($wd?.['payout_method'] ?? 'bank_wire') === 'crypto') { %>
                            <div>
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Method &amp; Coin</span>
                                <strong class="font-mono text-bronzeLight">₿ <%- e($wd?.['crypto_currency']) %></strong>
                            </div>
                            <div>
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Blockchain Network</span>
                                <strong class="font-mono text-white"><%- e($wd?.['crypto_network']) %></strong>
                            </div>
                            <div class="sm:col-span-2">
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Receiving Wallet Address</span>
                                <strong class="font-mono text-white break-all"><%- e($wd?.['crypto_wallet_address']) %></strong>
                                <% if (!empty($wd?.['crypto_memo'])) { %>
                                    <span class="block text-[10px] text-stone">Memo: <%- e($wd?.['crypto_memo']) %></span>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div>
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Beneficiary Name</span>
                                <strong class="font-mono text-white">🏛 <%- e($wd?.['bank_account_name']) %></strong>
                            </div>
                            <div>
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Bank Name</span>
                                <strong class="font-mono text-white"><%- e($wd?.['bank_name']) %></strong>
                            </div>
                            <div>
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Account No. / IBAN</span>
                                <strong class="font-mono text-bronzeLight break-all"><%- e($wd?.['bank_account_number']) %></strong>
                            </div>
                            <div>
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Routing / SWIFT</span>
                                <strong class="font-mono text-white"><%- e($wd?.['bank_routing_swift'] || '—') %></strong>
                            </div>
                            <% if (!empty($wd?.['bank_address'])) { %>
                            <div class="sm:col-span-2 lg:col-span-4">
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Bank Address</span>
                                <strong class="font-mono text-white"><%- e($wd?.['bank_address']) %></strong>
                            </div>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
        <% } %>
    </div>

    <!-- Live Bid Alert Banner (Displayed when Admin updates Bid Price on any Artist Artwork) -->
    <% var $bidAlerts = array_values(array_filter($notifications, ($n) => ($n?.['type'] ?? '') === 'new_bid_alert')); %>
    <% if (!empty($bidAlerts)) { %>
        <div class="bg-[#1A2E22] text-ivory border-2 border-bronze p-6 mb-10 space-y-3 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-ivory/20 pb-3">
                <div class="flex items-center space-x-2.5">
                    <span class="bg-bronze text-white text-[10px] uppercase tracking-widest px-3 py-1 font-bold">🔔 Live Bid Alert</span>
                    <h2 class="font-serif text-2xl text-ivory">New Bid Activity on Your Artwork</h2>
                </div>
            </div>
            <div class="space-y-2 text-xs">
                <% for (const $ba of Object.values(array_slice($bidAlerts, 0, 3) || [])) { %>
                    <% var $baAuction = array_values(array_filter($auctions, ($a) => Number($a?.['artwork_id'] ?? 0) === Number($ba?.['artwork_id'] ?? -1)))[0] ?? null;
                       var $baEndsAt = $baAuction?.['ends_at'] ?? $ba?.['ends_at'] ?? '';
                       var $baStatus = $baAuction?.['status'] ?? 'active'; %>
                    <div class="bg-obsidian/80 border border-bronze/50 px-4 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div>
                            <p class="font-semibold text-bronzeLight text-sm"><%- e($ba?.['title']) %></p>
                            <p class="text-ivory/90 mt-0.5"><%- e($ba?.['message']) %></p>
                            <% if ($baStatus === 'active' && !empty($baEndsAt)) { %>
                                <p class="mt-1.5 inline-flex items-center space-x-2 bg-[#1A2E22] border border-bronze/60 px-2.5 py-1 text-[11px] uppercase tracking-widest text-ivory">
                                    <span>⏱ Live Bid Countdown:</span>
                                    <strong class="text-bronzeLight font-mono" data-countdown="<%- e($baEndsAt) %>"><%- e(time_remaining_label($baEndsAt)) %></strong>
                                </p>
                            <% } else if (str_starts_with(String($baStatus), 'closed')) { %>
                                <p class="mt-1.5 inline-flex items-center space-x-2 bg-charcoal border border-stone/40 px-2.5 py-1 text-[11px] uppercase tracking-widest text-stone">
                                    <span>⏱ Countdown Complete · Auction Closed</span>
                                </p>
                            <% } %>
                        </div>
                        <% if (!empty($ba?.['bid_amount'])) { %>
                            <div class="text-right whitespace-nowrap">
                                <span class="block text-[9px] uppercase tracking-widest text-stone">Current Bid Price</span>
                                <span class="font-serif text-2xl font-bold text-bronzeLight"><%- format_money(Number($ba?.['bid_amount'])) %></span>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    <% } %>

    <!-- Curatorial & AI-Powered Authentication Payment Invoices (Download & Print Copy for Artist) -->
    <div id="authentication-invoices" class="bg-white border-2 border-bronze p-6 sm:p-8 mb-10 space-y-5 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4">
            <div>
                <p class="text-[10px] uppercase tracking-widest text-bronze font-semibold">Independent Connoisseurship &amp; AI Forensic Verification Billing</p>
                <h2 class="font-serif text-2xl sm:text-3xl text-obsidian mt-0.5">Curatorial &amp; AI-Powered Authentication Invoices</h2>
            </div>
            <span class="bg-obsidian text-bronzeLight text-[10px] uppercase tracking-widest px-3 py-1.5 font-semibold self-start sm:self-center">
                <%- count($authInvoices || []) %> Official Invoice<%- count($authInvoices || []) === 1 ? '' : 's' %>
            </span>
        </div>

        <% if (empty($authInvoices)) { %>
            <p class="text-xs text-stone">
                No authentication payment invoices have been issued for your studio works yet. When the Curatorial &amp; AI Authentication Board generates an authentication invoice for your submitted masterpiece, your official printable and downloadable invoice copy will appear here.
            </p>
        <% } else { %>
            <div class="space-y-4">
                <% for (const $inv of Object.values($authInvoices || [])) { %>
                    <% var $invPaid = ($inv?.['status'] ?? 'unpaid') === 'paid';
                       var $invCurrency = $inv?.['currency'] ?? 'USD'; %>
                    <div class="border border-hairline bg-ivory p-5 sm:p-6 space-y-4">
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-hairline pb-4">
                            <div class="space-y-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-mono text-xs font-bold text-obsidian bg-white border border-hairline px-2.5 py-0.5">
                                        <%- e($inv?.['invoice_number']) %>
                                    </span>
                                    <% if ($invPaid) { %>
                                        <span class="bg-[#1A2E22] text-ivory text-[10px] uppercase tracking-widest px-2.5 py-0.5 font-semibold">
                                            ✓ Paid &amp; Verified
                                        </span>
                                    <% } else { %>
                                        <span class="bg-bronze text-white text-[10px] uppercase tracking-widest px-2.5 py-0.5 font-semibold">
                                            ● Awaiting Authentication Payment
                                        </span>
                                    <% } %>
                                    <% if (!empty($inv?.['due_date'])) { %>
                                        <span class="text-[11px] text-stone">Due: <%- e($inv?.['due_date']) %></span>
                                    <% } %>
                                </div>
                                <h3 class="font-serif text-2xl text-obsidian">
                                    Artwork Verified: <span class="italic">"<%- e($inv?.['artwork_title']) %>"</span>
                                </h3>
                                <p class="text-xs text-bronze font-semibold"><%- e($inv?.['service_type']) %></p>
                            </div>

                            <div class="flex flex-wrap items-center gap-3">
                                <div class="text-left lg:text-right mr-2">
                                    <span class="block text-[10px] uppercase tracking-widest text-stone">Authentication Fee</span>
                                    <span class="font-serif text-2xl font-bold text-obsidian">
                                        <%- format_money_exact(Number($inv?.['fee_amount'] ?? 0), $invCurrency) %> <span class="text-xs font-mono"><%- e($invCurrency) %></span>
                                    </span>
                                </div>
                                <a href="/invoices/<%- Number($inv?.['id']) %>/download" class="bg-obsidian text-ivory px-4 py-2.5 text-[11px] uppercase tracking-widest font-semibold hover:bg-bronze transition">
                                    ⬇ Download Invoice Copy
                                </a>
                                <a href="/invoices/<%- Number($inv?.['id']) %>?print=1" target="_blank" class="border border-obsidian bg-white text-obsidian px-4 py-2.5 text-[11px] uppercase tracking-widest font-semibold hover:bg-obsidian hover:text-ivory transition">
                                    🖨 View &amp; Print Invoice
                                </a>
                            </div>
                        </div>

                        <!-- Account & Cryptocurrency Details To Be Paid To -->
                        <div class="bg-[#181615] text-ivory p-4 border border-bronze/50 space-y-3 text-xs">
                            <% if (!empty($inv?.['payment_account_number']) || !empty($inv?.['payment_bank_name'])) { %>
                            <div>
                                <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold mb-2">🏛 Bank Wire / Transfer Account Details</p>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-widest text-stone">Account Name To Pay</span>
                                        <strong class="font-mono text-white"><%- e($inv?.['payment_account_name'] ?? '—') %></strong>
                                    </div>
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-widest text-stone">Bank / Institution</span>
                                        <strong class="font-mono text-white"><%- e($inv?.['payment_bank_name'] ?? '—') %></strong>
                                    </div>
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-widest text-stone">Account No. / IBAN</span>
                                        <strong class="font-mono text-bronzeLight break-all"><%- e($inv?.['payment_account_number'] ?? '—') %></strong>
                                    </div>
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-widest text-stone">Routing / SWIFT</span>
                                        <strong class="font-mono text-white"><%- e($inv?.['payment_routing_details'] || $inv?.['invoice_number']) %></strong>
                                    </div>
                                    <% if (!empty($inv?.['payment_bank_address'])) { %>
                                    <div class="sm:col-span-2 lg:col-span-4">
                                        <span class="block text-[10px] uppercase tracking-widest text-stone">Bank Address / Branch Location</span>
                                        <strong class="font-mono text-white"><%- e($inv?.['payment_bank_address']) %></strong>
                                    </div>
                                    <% } %>
                                </div>
                            </div>
                            <% } %>

                            <% if (!empty($inv?.['crypto_wallet_address']) || !empty($inv?.['crypto_currency'])) { %>
                            <div class="<%- (!empty($inv?.['payment_account_number']) || !empty($inv?.['payment_bank_name'])) ? 'pt-3 border-t border-white/15' : '' %>">
                                <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold mb-2">₿ Cryptocurrency Payment Details</p>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-widest text-stone">Cryptocurrency / Asset</span>
                                        <strong class="font-mono text-white"><%- e($inv?.['crypto_currency'] ?? '—') %></strong>
                                    </div>
                                    <div>
                                        <span class="block text-[10px] uppercase tracking-widest text-stone">Blockchain Network</span>
                                        <strong class="font-mono text-white"><%- e($inv?.['crypto_network'] ?? '—') %></strong>
                                    </div>
                                    <div class="sm:col-span-2">
                                        <span class="block text-[10px] uppercase tracking-widest text-stone">Receiving Crypto Wallet Address</span>
                                        <strong class="font-mono text-bronzeLight break-all"><%- e($inv?.['crypto_wallet_address'] ?? '—') %></strong>
                                        <% if (!empty($inv?.['crypto_memo'])) { %>
                                            <span class="block text-[10px] font-mono text-stone mt-0.5">Memo / Tag: <%- e($inv?.['crypto_memo']) %></span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- 8-Metric Studio KPI Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-5 mb-12">
        <div class="bg-white border border-hairline p-6">
            <p class="text-[10px] uppercase tracking-widest text-stone">Total Uploaded Works</p>
            <p class="font-serif text-4xl font-semibold text-obsidian mt-1"><%- $stats?.['total_submissions'] %></p>
        </div>
        <div class="bg-white border border-hairline p-6">
            <p class="text-[10px] uppercase tracking-widest text-stone">Awaiting Admin Review</p>
            <p class="font-serif text-4xl font-semibold text-bronze mt-1"><%- $stats?.['awaiting_review'] %></p>
        </div>
        <div class="bg-white border border-hairline p-6">
            <p class="text-[10px] uppercase tracking-widest text-stone">Approved / Published</p>
            <p class="font-serif text-4xl font-semibold text-obsidian mt-1"><%- $stats?.['approved_artworks'] %></p>
        </div>
        <div class="bg-white border border-hairline p-6">
            <p class="text-[10px] uppercase tracking-widest text-stone">Auctions Started (Live)</p>
            <p class="font-serif text-4xl font-semibold text-obsidian mt-1"><%- $stats?.['active_auctions'] %></p>
        </div>
        <div class="bg-white border border-hairline p-6">
            <p class="text-[10px] uppercase tracking-widest text-stone">Sold Artworks</p>
            <p class="font-serif text-4xl font-semibold text-obsidian mt-1"><%- $stats?.['sold_artworks'] %></p>
        </div>
        <div class="bg-white border border-hairline p-6">
            <p class="text-[10px] uppercase tracking-widest text-stone">Ended Unsold Lots</p>
            <p class="font-serif text-4xl font-semibold text-stone mt-1"><%- $stats?.['unsold_artworks'] %></p>
        </div>
        <div class="bg-white border border-hairline p-6">
            <p class="text-[10px] uppercase tracking-widest text-stone">Gross Hammer Sales</p>
            <p class="font-serif text-3xl font-semibold text-obsidian mt-1"><%- format_money($stats?.['total_sales_volume']) %></p>
        </div>
        <div class="bg-[#181615] text-ivory border border-bronze p-6">
            <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold">Studio Wallet Balance</p>
            <p class="font-serif text-2xl font-semibold text-white mt-1">
                <%- format_money($stats?.['wallet_balance'] ?? $stats?.['completed_payouts'] ?? 0) %>
                <% if (Number($stats?.['processing_withdrawals'] ?? 0) > 0) { %>
                    <span class="text-xs text-bronzeLight block font-sans">Processing Withdrawal: <%- format_money($stats?.['processing_withdrawals']) %> (2–7 Business Days)</span>
                <% } else { %>
                    <span class="text-xs text-stone block font-sans">Pending Wire: <%- format_money($stats?.['pending_payouts']) %></span>
                <% } %>
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <!-- Left 8 Columns: Uploaded Artworks, Expected vs Agreed Prices, and Live Auction Status -->
        <div class="lg:col-span-8 space-y-10">
            <div class="bg-white border border-hairline p-8">
                <div class="flex items-center justify-between border-b border-hairline pb-4 mb-6">
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-bronze font-semibold">Your Studio Catalogue &amp; Valuation Status</p>
                        <h2 class="font-serif text-2xl text-obsidian">Uploaded Works, Agreed Prices &amp; Auction Status</h2>
                    </div>
                    <a href="/artist/submit" class="bg-obsidian text-ivory px-4 py-2 text-[10px] uppercase tracking-widest hover:bg-bronze transition">+ Upload Work</a>
                </div>

                <div class="divide-y divide-hairline">
                    <% for (const $sub of Object.values($submissions || [])) { %>
                        <% var $art = $sub?.['artwork'] ?? [];
                        var $auc = $sub?.['auction'] ?? null;
                        var $aucState = $auc?.['status'] ?? 'unscheduled';
                        var $expectedPrice = Number(($sub?.['artist_expected_price'] ?? $art?.['artist_expected_price'] ?? $art?.['estimate_high'] ?? $sub?.['reserve_price'] ?? 0));
                        var $agreedPrice = $sub?.['agreed_price'] ?? $art?.['agreed_price'] ?? ($auc ? $auc?.['reserve_price'] : null);
                        var $currentBid = Number(($auc?.['current_bid'] ?? $sub?.['current_bid'] ?? $art?.['current_bid'] ?? $art?.['starting_bid'] ?? 0));
                        var $hasBidUpdate = !empty($auc?.['current_bid']) || !empty($sub?.['current_bid']) || !empty($art?.['current_bid']); %>
                        <div class="py-6 space-y-4">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                <div class="flex items-center space-x-4">
                                    <img src="<%- e($art?.['primary_image'] ?? '') %>" alt="" class="w-20 h-20 object-cover bg-alabaster border border-hairline">
                                    <div>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="font-mono text-[11px] font-semibold text-bronze"><%- e($sub?.['reference_code']) %></span>
                                            <!-- Auction Started / Ended Indicator Badge + Live Countdown -->
                                            <% if ($aucState === 'active') { %>
                                                <span class="text-[10px] uppercase tracking-widest px-2.5 py-0.5 bg-[#1A2E22] text-ivory font-semibold">
                                                    ● Auction Started (Live Bidding)
                                                </span>
                                                <% if (!empty($auc?.['ends_at'])) { %>
                                                    <span class="text-[10px] uppercase tracking-widest px-2.5 py-0.5 bg-obsidian text-bronzeLight border border-bronze font-semibold">
                                                        ⏱ Closes In: <strong class="font-mono" data-countdown="<%- e($auc?.['ends_at']) %>"><%- e(time_remaining_label($auc?.['ends_at'])) %></strong>
                                                    </span>
                                                <% } %>
                                            <% } else if ($aucState === 'upcoming') { %>
                                                <span class="text-[10px] uppercase tracking-widest px-2.5 py-0.5 bg-bronze text-white font-semibold">
                                                    ◷ Scheduled Upcoming Auction
                                                </span>
                                            <% } else if ($aucState === 'closed_sold') { %>
                                                <span class="text-[10px] uppercase tracking-widest px-2.5 py-0.5 bg-obsidian text-bronzeLight font-semibold">
                                                    ✓ Auction Ended — SOLD
                                                </span>
                                            <% } else if ($aucState === 'closed_unsold') { %>
                                                <span class="text-[10px] uppercase tracking-widest px-2.5 py-0.5 bg-alabaster text-stone border border-hairline font-semibold">
                                                    Auction Ended — Unsold
                                                </span>
                                            <% } else { %>
                                                <span class="text-[10px] uppercase tracking-widest px-2.5 py-0.5 bg-alabaster border border-hairline font-semibold text-charcoal">
                                                    Status: <%- e(strtoupper(str_replace('_', ' ', $sub?.['status']))) %>
                                                </span>
                                            <% } %>
                                        </div>

                                        <h3 class="font-serif text-2xl text-obsidian mt-1"><%- e($art?.['title'] ?? 'Untitled') %></h3>
                                        <p class="text-xs text-stone"><%- e($art?.['medium'] ?? '') %> · <%- e($art?.['dimensions'] ?? '') %></p>
                                    </div>
                                </div>

                                <div class="flex flex-wrap items-center gap-2 self-end sm:self-center">
                                    <% if (!empty($sub?.['invoice'])) { %>
                                        <a href="/invoices/<%- Number($sub?.['invoice']?.['id']) %>/download" class="px-4 py-2 bg-obsidian text-bronzeLight border border-bronze text-[11px] uppercase tracking-widest font-semibold hover:bg-bronze hover:text-white transition">
                                            ⬇ Download Invoice (<%- e($sub?.['invoice']?.['invoice_number']) %>)
                                        </a>
                                        <a href="/invoices/<%- Number($sub?.['invoice']?.['id']) %>?print=1" target="_blank" class="px-3.5 py-2 border border-obsidian bg-white text-obsidian text-[11px] uppercase tracking-widest font-semibold hover:bg-obsidian hover:text-ivory transition">
                                            🖨 View &amp; Print Invoice
                                        </a>
                                    <% } %>
                                    <% if ($aucState === 'closed_sold' || ($art?.['status'] ?? '') === 'sold') { %>
                                        <a href="/certificates/<%- Number($art?.['id']) %>" class="px-4 py-2 bg-[#1A2E22] text-ivory text-[11px] uppercase tracking-widest font-semibold hover:bg-bronze transition">
                                            ⎙ Official Sale Certificate
                                        </a>
                                    <% } %>
                                    <% if (in_array($sub?.['status'], ['draft', 'submitted', 'changes_requested'], true)) { %>
                                        <a href="/artist/submit?edit_id=<%- Number($sub?.['id']) %>" class="px-4 py-2 border border-obsidian text-[11px] uppercase tracking-widest hover:bg-obsidian hover:text-ivory transition">
                                            Edit Upload
                                        </a>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Pricing & Admin Valuation Ledger for this Upload -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 bg-ivory border border-hairline p-4 text-xs">
                                <div>
                                    <span class="block text-[10px] uppercase tracking-widest text-stone">Your Expected Price</span>
                                    <span class="font-serif text-lg font-semibold text-obsidian"><%- format_money($expectedPrice) %></span>
                                </div>
                                <div>
                                    <span class="block text-[10px] uppercase tracking-widest text-stone">Agreed House Price</span>
                                    <% if ($agreedPrice !== null) { %>
                                        <span class="font-serif text-lg font-semibold text-bronze"><%- format_money(Number($agreedPrice)) %></span>
                                        <% if (($sub?.['price_agreement_status'] ?? '') === 'accepted_by_artist') { %>
                                            <span class="block text-[10px] text-green-800 font-semibold">✓ Accepted by You</span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-stone italic">Pending Curatorial Agreement</span>
                                    <% } %>
                                </div>
                                <div>
                                    <span class="block text-[10px] uppercase tracking-widest text-stone">Controlled Starting Bid</span>
                                    <span class="font-serif text-lg font-semibold text-obsidian"><%- format_money($auc?.['starting_bid'] ?? $sub?.['suggested_starting_bid'] ?? 0) %></span>
                                </div>
                                <div class="<%- $hasBidUpdate ? 'bg-[#FDFBF7] border border-bronze p-2 -m-2' : '' %>">
                                    <span class="block text-[10px] uppercase tracking-widest <%- $hasBidUpdate ? 'text-bronze font-bold' : 'text-stone' %>">
                                        <%- $aucState === 'closed_sold' ? 'Final Hammer Price' : ($hasBidUpdate ? '🔔 Live Bid Price' : 'Current Live Bid') %>
                                    </span>
                                    <span class="font-serif text-xl font-bold text-obsidian">
                                        <%- format_money($currentBid) %>
                                        <% if ($auc) { %>
                                            <span class="font-sans text-[11px] text-stone">(<%- Number($auc?.['bid_count']) %> bids)</span>
                                        <% } %>
                                    </span>
                                    <% if ($aucState === 'active' && !empty($auc?.['ends_at'])) { %>
                                        <span class="block text-[11px] text-bronze font-semibold mt-1">
                                            ⏱ Live Countdown: <strong class="font-mono" data-countdown="<%- e($auc?.['ends_at']) %>"><%- e(time_remaining_label($auc?.['ends_at'])) %></strong>
                                        </span>
                                    <% } else if (str_starts_with(String($aucState), 'closed')) { %>
                                        <span class="block text-[10px] uppercase tracking-widest text-stone font-semibold mt-1">
                                            ⏱ Auction Closed Automatically
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Direct Price Negotiation & Message Thread with Admin -->
                            <% var $negMessages = is_array($sub?.['negotiation_messages'] ?? null) ? $sub?.['negotiation_messages'] : []; %>
                            <div class="bg-alabaster/70 border border-hairline p-4 space-y-3 text-xs">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] uppercase tracking-widest font-semibold text-obsidian">
                                        Curator Valuation Note &amp; Price Agreement Thread
                                    </span>
                                    <span class="text-[10px] text-stone">Ref: <%- e($sub?.['reference_code']) %></span>
                                </div>
                                <p class="text-charcoal"><%- e($sub?.['admin_feedback'] ?? '') %></p>

                                <% if (!empty($negMessages)) { %>
                                    <div class="space-y-1.5 border-t border-hairline pt-2 max-h-36 overflow-y-auto">
                                        <% for (const $nm of Object.values($negMessages || [])) { %>
                                            <div class="text-[11px]">
                                                <strong class="<%- ($nm?.['sender'] ?? '') === 'admin' ? 'text-bronze' : 'text-obsidian' %>">
                                                    [<%- e($nm?.['sender_name'] ?? 'Note') %>]:
                                                </strong>
                                                <span class="text-charcoal"><%- e($nm?.['text'] ?? '') %></span>
                                                <span class="text-[10px] text-stone ml-1">(<%- e($nm?.['created_at'] ?? '') %>)</span>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>

                                <% if ($aucState !== 'closed_sold') { %>
                                    <form action="/artist/submissions/negotiate" method="POST" class="pt-2 border-t border-hairline flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                                        <%- csrf_field() %>
                                        <input type="hidden" name="submission_id" value="<%- Number($sub?.['id']) %>">

                                        <% if ($agreedPrice !== null && ($sub?.['price_agreement_status'] ?? '') !== 'accepted_by_artist') { %>
                                            <button type="submit" name="response_action" value="accept" class="bg-[#1A2E22] text-ivory px-4 py-2 text-[10px] uppercase tracking-widest font-semibold hover:bg-bronze transition whitespace-nowrap">
                                                ✓ Accept Agreed Price (<%- format_money(Number($agreedPrice)) %>)
                                            </button>
                                        <% } %>

                                        <input type="number" step="50" name="counter_price" value="<%- $expectedPrice %>" placeholder="Counter $" class="w-full sm:w-28 bg-white border border-hairline px-2.5 py-1.5 text-xs font-semibold">
                                        <input type="text" name="artist_message" placeholder="Send a message or counter-offer note to Admin..." class="flex-1 bg-white border border-hairline px-3 py-1.5 text-xs">
                                        <button type="submit" name="response_action" value="counter" class="border border-obsidian bg-white text-obsidian px-4 py-1.5 text-[10px] uppercase tracking-widest hover:bg-obsidian hover:text-ivory transition whitespace-nowrap">
                                            Send to Admin
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Right 4 Columns: Studio Profile Preview & Notifications -->
        <div class="lg:col-span-4 space-y-8">
            <!-- How Your Artist Profile Looks Card + Instant Profile Picture Upload -->
            <div class="bg-white border border-hairline p-6 space-y-4" x-data="{
                previewPhoto: '<%- e($profile?.['profile_photo']) %>',
                photoData: '',
                handleQuickPhoto(e) {
                    const self = this;
                    const inputEl = e.target;
                    const file = inputEl.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        const rawDataUrl = ev.target.result;
                        self.previewPhoto = rawDataUrl;
                        self.photoData = rawDataUrl;
                        const img = new Image();
                        img.onload = () => {
                            try {
                                const maxDim = 600;
                                let w = img.width || 400;
                                let h = img.height || 400;
                                if (w > maxDim || h > maxDim) {
                                    if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
                                    else { w = Math.round((w * maxDim) / h); h = maxDim; }
                                }
                                const canvas = document.createElement('canvas');
                                canvas.width = w;
                                canvas.height = h;
                                const ctx = canvas.getContext('2d');
                                ctx.drawImage(img, 0, 0, w, h);
                                const compressed = canvas.toDataURL('image/jpeg', 0.82);
                                self.previewPhoto = compressed;
                                self.photoData = compressed;
                                inputEl.removeAttribute('required');
                                inputEl.value = '';
                            } catch (_) {}
                        };
                        img.src = rawDataUrl;
                    };
                    reader.readAsDataURL(file);
                }
            }">
                <div class="flex items-center justify-between border-b border-hairline pb-3">
                    <h2 class="text-xs uppercase tracking-widest font-semibold text-obsidian">Your Artist Profile &amp; Portrait</h2>
                </div>
                <div class="flex items-center space-x-3">
                    <img :src="previewPhoto" src="<%- e($profile?.['profile_photo']) %>" alt="" class="w-16 h-16 object-cover border border-hairline bg-alabaster">
                    <div>
                        <h3 class="font-serif text-xl text-obsidian"><%- e($profile?.['display_name']) %></h3>
                        <p class="text-[11px] text-bronze uppercase tracking-widest"><%- e($profile?.['country']) %> · <%- e($profile?.['years_active'] ?? '') %></p>
                    </div>
                </div>

                <!-- Direct 1-Click Artist Profile Picture Upload Form -->
                <form action="/artist/profile" method="POST" enctype="multipart/form-data" class="bg-ivory border border-hairline p-3 space-y-2 text-xs">
                    <%- csrf_field() %>
                    <input type="hidden" name="display_name" value="<%- e($profile?.['display_name']) %>">
                    <input type="hidden" name="discipline" value="<%- e($profile?.['discipline']) %>">
                    <input type="hidden" name="country" value="<%- e($profile?.['country']) %>">
                    <input type="hidden" name="city" value="<%- e($profile?.['city'] ?? '') %>">
                    <input type="hidden" name="years_active" value="<%- e($profile?.['years_active'] ?? '') %>">
                    <input type="hidden" name="biography" value="<%- e($profile?.['biography']) %>">
                    <input type="hidden" name="artist_statement" value="<%- e($profile?.['artist_statement'] ?? '') %>">
                    <input type="hidden" name="website" value="<%- e($profile?.['website'] ?? '') %>">
                    <input type="hidden" name="social_instagram" value="<%- e($profile?.['social_instagram'] ?? '') %>">
                    <input type="hidden" name="profile_photo_url" value="<%- e($profile?.['profile_photo']) %>">
                    <input type="hidden" name="profile_photo_data" :value="photoData">
                    <input type="hidden" name="return_to" value="/artist/dashboard">

                    <label class="block text-[10px] uppercase tracking-widest text-obsidian font-semibold">Upload New Profile Picture</label>
                    <input type="file" name="profile_photo_file" accept="image/*" @change="handleQuickPhoto($event)" required class="w-full text-[11px]">
                    <button type="submit" class="w-full bg-obsidian text-ivory py-2 text-[10px] uppercase tracking-widest font-semibold hover:bg-bronze transition">
                        Save New Profile Picture
                    </button>
                </form>

                <p class="text-xs text-charcoal/80 line-clamp-3 leading-relaxed"><%- e($profile?.['biography']) %></p>
                <div class="pt-1">
                    <a href="/artist/profile" class="block w-full text-center py-2.5 border border-obsidian text-[10px] uppercase tracking-widest hover:bg-obsidian hover:text-ivory transition">Full Profile Editor</a>
                </div>
            </div>

            <div class="bg-white border border-hairline p-6">
                <div class="flex items-center justify-between border-b border-hairline pb-3 mb-4">
                    <h2 class="text-xs uppercase tracking-widest font-semibold text-obsidian">Studio Notifications &amp; Bid Alerts</h2>
                    <form action="/buyer/notifications/read" method="POST">
                        <%- csrf_field() %>
                        <input type="hidden" name="notification_id" value="-1">
                        <button type="submit" class="text-[10px] uppercase tracking-wider text-bronze hover:underline">Mark All Read</button>
                    </form>
                </div>

                <% if (empty($notifications)) { %>
                    <p class="text-xs text-stone py-4">No studio notifications yet.</p>
                <% } else { %>
                    <div class="divide-y divide-hairline">
                        <% for (const $n of Object.values($notifications || [])) { %>
                            <% var $isBidAlert = ($n?.['type'] ?? '') === 'new_bid_alert'; %>
                            <div class="py-3.5 space-y-1.5 <%- $isBidAlert ? 'bg-[#FDFBF7] border-l-4 border-bronze pl-3 pr-2 my-1' : (empty($n?.['read_at']) ? 'bg-ivory/70 -mx-2 px-2' : '') %>">
                                <div class="flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-1.5">
                                        <% if ($isBidAlert) { %>
                                            <span class="bg-bronze text-white text-[9px] uppercase tracking-widest px-2 py-0.5 font-bold">🔔 BID ALERT</span>
                                        <% } %>
                                        <p class="text-xs font-semibold text-obsidian"><%- e($n?.['title']) %></p>
                                    </div>
                                    <% if (empty($n?.['read_at'])) { %>
                                        <span class="w-2 h-2 rounded-full bg-bronze flex-shrink-0"></span>
                                    <% } %>
                                </div>
                                <p class="text-xs text-charcoal/90 leading-relaxed"><%- e($n?.['message']) %></p>
                                <% if (!empty($n?.['bid_amount'])) { %>
                                    <p class="text-[11px] font-serif font-bold text-bronze">Updated Live Bid Price: <%- format_money(Number($n?.['bid_amount'])) %></p>
                                <% } %>
                                <% if (!empty($n?.['action_url'])) { %>
                                    <a href="<%- e($n?.['action_url']) %>" class="inline-block text-[10px] uppercase tracking-widest text-bronze font-semibold pt-1">View Record →</a>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Official Curatorial & Authentication Support Contact -->
            <div class="bg-[#181615] text-ivory border border-bronze p-6 space-y-2 text-xs">
                <p class="text-[10px] uppercase tracking-widest text-bronzeLight font-semibold">Curatorial &amp; Authentication Concierge</p>
                <p class="text-ivory/80 leading-relaxed">
                    For inquiries regarding artwork authentication invoices, payment remittance, or live auction scheduling, contact our Curatorial Desk directly:
                </p>
                <p class="pt-1">
                    <a href="mailto:Art-Ally@consultant.com" class="text-bronzeLight hover:text-white underline font-mono font-semibold text-sm">Art-Ally@consultant.com</a>
                </p>
            </div>
        </div>
    </div>
</div>
