<% 
var $watchedIds = $watchedIds ?? user_watchlist_ids();
var $auction = $lot?.['auction'] ?? null;
var $isWatched = in_array(Number($lot?.['id']), $watchedIds, true);
var $aucStatus = $auction?.['status'] ?? 'active';
var $currentBid = Number(($auction?.['current_bid'] ?? $lot?.['current_bid'] ?? $lot?.['starting_bid'] ?? 0));
var $bidCount = Number(($auction?.['bid_count'] ?? (!empty($lot?.['current_bid'])) ? 1 : 0));
var $lotNumber = $auction?.['lot_number'] ?? ('LOT ' + sprintf('%02d', Number($lot?.['id']))); %>
<article class="group bg-white border border-hairline flex flex-col justify-between transition duration-300 hover:border-bronze">
    <div>
        <!-- Artwork Photography Frame -->
        <div class="relative aspect-[4/5] bg-alabaster overflow-hidden">
            <a href="/artworks/<%- e($lot?.['slug']) %>" class="block w-full h-full">
                <img
                    src="<%- e($lot?.['primary_image']) %>"
                    alt="<%- e($lot?.['title']) %> by <%- e($lot?.['artist_name']) %>"
                    loading="lazy"
                    class="w-full h-full object-cover gallery-image-zoom"
                >
            </a>

            <!-- Top Left Lot Number & Status Badge -->
            <div class="absolute top-4 left-4 flex items-center space-x-2">
                <span class="bg-obsidian/90 text-ivory text-[10px] tracking-widest uppercase px-2.5 py-1 font-medium">
                    <%- e($lotNumber) %>
                </span>
                <% if ($aucStatus === 'active') { %>
                    <span class="bg-bronze text-white text-[10px] tracking-widest uppercase px-2.5 py-1 font-medium">
                        Live Bidding
                    </span>
                <% } else if ($aucStatus === 'upcoming') { %>
                    <span class="bg-white/95 text-obsidian text-[10px] tracking-widest uppercase px-2.5 py-1 font-medium border border-hairline">
                        Upcoming
                    </span>
                <% } else if ($aucStatus === 'closed_sold') { %>
                    <span class="bg-obsidian text-bronzeLight text-[10px] tracking-widest uppercase px-2.5 py-1 font-medium">
                        Sold
                    </span>
                <% } %>
            </div>

            <!-- Top Right Watchlist Button -->
            <form action="/buyer/watchlist/toggle" method="POST" class="absolute top-4 right-4">
                <%- csrf_field() %>
                <input type="hidden" name="artwork_id" value="<%- Number($lot?.['id']) %>">
                <input type="hidden" name="return_url" value="<%- e($_SERVER?.['REQUEST_URI'] ?? '/') %>">
                <button
                    type="submit"
                    title="<%- $isWatched ? 'Remove from Watchlist' : 'Save to Watchlist' %>"
                    class="w-9 h-9 flex items-center justify-center bg-white/90 hover:bg-obsidian hover:text-white transition border border-hairline <%- $isWatched ? 'text-bronze' : 'text-obsidian' %>"
                >
                    <svg class="w-4 h-4" fill="<%- $isWatched ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                </button>
            </form>
        </div>

        <!-- Editorial Metadata -->
        <div class="p-6">
            <div class="flex items-center justify-between text-[11px] uppercase tracking-widest text-stone mb-1.5">
                <a href="/artists/<%- e($lot?.['artist_slug'] ?? '') %>" class="hover:text-bronze transition font-semibold text-charcoal">
                    <%- e($lot?.['artist_name']) %>
                </a>
                <span><%- e(String(($lot?.['year_created'] ?? '') ?? "")) %></span>
            </div>

            <h3 class="font-serif text-2xl font-normal text-obsidian group-hover:text-bronze transition leading-snug mb-2">
                <a href="/artworks/<%- e($lot?.['slug']) %>">
                    <span class="italic"><%- e($lot?.['title']) %></span>
                </a>
            </h3>

            <p class="text-xs text-stone line-clamp-1 mb-5">
                <%- e($lot?.['medium']) %>
            </p>

            <!-- Bid & Estimate Ledger -->
            <div class="border-t border-hairline pt-4 grid grid-cols-2 gap-4 text-xs">
                <div>
                    <p class="text-[10px] uppercase tracking-widest text-stone mb-0.5">
                        <%- $aucStatus === 'upcoming' ? 'Starting Bid' : ($aucStatus === 'closed_sold' ? 'Hammer Price' : 'Current Bid') %>
                    </p>
                    <p class="font-serif text-xl font-semibold text-obsidian">
                        <%- format_money($currentBid, $lot?.['currency'] ?? 'USD') %>
                    </p>
                    <p class="text-[11px] text-stone">
                        <%- $bidCount %> <%- $bidCount === 1 ? 'bid' : 'bids' %>
                        <% if (!empty($lot?.['estimate_low']) && !empty($lot?.['estimate_high'])) { %>
                            · Est. <%- format_money($lot?.['estimate_low']) %>–<%- format_money($lot?.['estimate_high']) %>
                        <% } %>
                    </p>
                </div>

                <div class="text-right flex flex-col justify-between">
                    <div>
                        <p class="text-[10px] uppercase tracking-widest text-stone mb-0.5">
                            <%- $aucStatus === 'upcoming' ? 'Opens In' : 'Closes In' %>
                        </p>
                        <% if ($auction && $aucStatus === 'active') { %>
                            <p class="text-xs font-medium text-bronze" data-countdown="<%- e($auction?.['ends_at']) %>">
                                <%- e(time_remaining_label($auction?.['ends_at'])) %>
                            </p>
                        <% } else if ($auction && $aucStatus === 'upcoming') { %>
                            <p class="text-xs font-medium text-charcoal" data-countdown="<%- e($auction?.['starts_at']) %>">
                                <%- e(time_remaining_label($auction?.['starts_at'])) %>
                            </p>
                        <% } else { %>
                            <p class="text-xs font-medium text-stone">Auction Closed</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="px-6 pb-6">
        <a href="/artworks/<%- e($lot?.['slug']) %>" class="block w-full text-center py-3 border border-obsidian text-[11px] uppercase tracking-widest font-medium text-obsidian group-hover:bg-obsidian group-hover:text-ivory transition">
            <%- $aucStatus === 'active' ? 'View Lot &amp; Place Bid' : 'Explore Lot Details' %>
        </a>
    </div>
</article>
